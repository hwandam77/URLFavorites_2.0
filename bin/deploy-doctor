#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "shellwords"

USAGE = <<~TEXT
  Usage:
    bin/deploy-doctor pre [--report]
    bin/deploy-doctor post [--report]

  pre  checks that local Git is clean/synced and the VPS checkout has no source drift.
  post also checks that the VPS checkout matches local HEAD and the app is healthy.

  Environment overrides:
    URLF_REMOTE_HOST   default: vps-server
    URLF_REMOTE_PATH   default: /home/hwandam/services/rails/urlfavorites_2.0
    URLF_SERVICE       default: rails-puma@urlfavorites_2.0
    URLF_REMOTE_PORT   default: 3003
    URLF_HEALTH_PATH   default: /favorites
    URLF_PUBLIC_URL    default: https://urlf.hwandam.kr/favorites
    URLF_PRIMARY_DB    default: storage/production.sqlite3
    URLF_QUEUE_DB      default: storage/production_queue.sqlite3
    URLF_EXPECTED_HEAD optional commit SHA for post deploy checks
TEXT

Check = Struct.new(:name, :ok, :detail, keyword_init: true)

PROTECTED_RUNTIME_PATHS = [
  %r{\Astorage/.*\.sqlite3},
  %r{\Adb/.*\.sqlite3},
  %r{\Alog/},
  %r{\Atmp/}
].freeze

mode = ARGV.find { |arg| %w[pre post].include?(arg) } || "pre"
report_only = ARGV.include?("--report")
unknown_args = ARGV - [ mode, "--report" ]

if unknown_args.any?
  warn USAGE
  abort "Unknown argument(s): #{unknown_args.join(', ')}"
end

remote_host = ENV.fetch("URLF_REMOTE_HOST", "vps-server")
remote_path = ENV.fetch("URLF_REMOTE_PATH", "/home/hwandam/services/rails/urlfavorites_2.0")
service = ENV.fetch("URLF_SERVICE", "rails-puma@urlfavorites_2.0")
remote_port = ENV.fetch("URLF_REMOTE_PORT", "3003")
health_path = ENV.fetch("URLF_HEALTH_PATH", "/favorites")
public_url = ENV.fetch("URLF_PUBLIC_URL", "https://urlf.hwandam.kr/favorites")
primary_db = ENV.fetch("URLF_PRIMARY_DB", "storage/production.sqlite3")
queue_db = ENV.fetch("URLF_QUEUE_DB", "storage/production_queue.sqlite3")
expected_head = ENV["URLF_EXPECTED_HEAD"]

def capture(*cmd)
  stdout, stderr, status = Open3.capture3(*cmd)
  output = stdout.strip
  output = stderr.strip if output.empty?
  [ status.success?, output ]
end

def local_git(*args)
  capture("git", *args)
end

def remote_capture(remote_host, command)
  capture("ssh", remote_host, command)
end

def remote_git(remote_host, remote_path, *args)
  escaped_args = args.map { |arg| Shellwords.escape(arg) }.join(" ")
  command = "git -C #{Shellwords.escape(remote_path)} #{escaped_args}"
  remote_capture(remote_host, command)
end

def summarize_status(output)
  lines = output.lines.map(&:chomp)
  return "clean" if lines.empty?

  preview = lines.first(12).join("\n")
  extra = lines.length > 12 ? "\n... #{lines.length - 12} more" : ""
  "#{lines.length} changed path(s):\n#{preview}#{extra}"
end

def status_paths(line)
  line[3..].to_s.split(" -> ")
end

def protected_runtime_path?(path)
  PROTECTED_RUNTIME_PATHS.any? { |pattern| path.match?(pattern) }
end

def source_status(output)
  output.lines.reject do |line|
    paths = status_paths(line.chomp)
    paths.any? && paths.all? { |path| protected_runtime_path?(path) }
  end.join
end

def add_check(checks, name)
  ok, detail = yield
  checks << Check.new(name: name, ok: ok, detail: detail)
end

def branch_sync_status(git_runner)
  ok, upstream = git_runner.call("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
  return [ false, "no upstream configured" ] unless ok

  ok, counts = git_runner.call("rev-list", "--left-right", "--count", "#{upstream}...HEAD")
  return [ false, counts ] unless ok

  behind, ahead = counts.split.map(&:to_i)
  [ behind.zero? && ahead.zero?, "#{upstream}: ahead #{ahead}, behind #{behind}" ]
end

checks = []
local_head = nil
remote_head = nil

puts "URLFavorites deploy doctor (#{mode})"
puts "remote: #{remote_host}:#{remote_path}"
puts "service: #{service}, health: http://127.0.0.1:#{remote_port}#{health_path}"
puts

add_check(checks, "local Git repository") do
  local_git("rev-parse", "--show-toplevel")
end

add_check(checks, "local branch") do
  ok, branch = local_git("branch", "--show-current")
  [ ok && !branch.empty?, branch.empty? ? "detached HEAD" : branch ]
end

add_check(checks, "local HEAD") do
  ok, head = local_git("rev-parse", "HEAD")
  local_head = head if ok
  [ ok, head ]
end

add_check(checks, "local deployable source clean") do
  ok, status = local_git("status", "--porcelain")
  source_drift = source_status(status)
  [ ok && source_drift.empty?, summarize_status(source_drift) ]
end

add_check(checks, "local branch synced with upstream") do
  branch_sync_status(method(:local_git))
end

add_check(checks, "remote path exists") do
  remote_capture(remote_host, "test -d #{Shellwords.escape(remote_path)}")
end

add_check(checks, "remote production DB files present") do
  db_paths = [ primary_db, queue_db ].map { |path| File.join(remote_path, path) }
  escaped_paths = db_paths.map { |path| Shellwords.escape(path) }.join(" ")
  ok, output = remote_capture(remote_host, "stat -c '%n %s bytes' #{escaped_paths}")
  sizes = output.lines.filter_map { |line| line.split[-2].to_i if line.end_with?("bytes\n") || line.end_with?("bytes") }
  [ ok && sizes.length == db_paths.length && sizes.all?(&:positive?), output ]
end

add_check(checks, "remote branch") do
  remote_git(remote_host, remote_path, "branch", "--show-current")
end

add_check(checks, "remote HEAD") do
  ok, head = remote_git(remote_host, remote_path, "rev-parse", "HEAD")
  remote_head = head if ok
  [ ok, head ]
end

add_check(checks, "remote deployable source clean") do
  ok, status = remote_git(remote_host, remote_path, "status", "--porcelain")
  source_drift = source_status(status)
  [ ok && source_drift.empty?, summarize_status(source_drift) ]
end

if mode == "post"
  add_check(checks, "remote matches expected HEAD") do
    expected = expected_head || local_head
    [ expected && remote_head && expected == remote_head, "expected=#{expected} remote=#{remote_head}" ]
  end

  add_check(checks, "systemd service active") do
    ok, output = remote_capture(remote_host, "systemctl is-active #{Shellwords.escape(service)}")
    [ ok && output == "active", output ]
  end

  add_check(checks, "remote health check") do
    url = "http://127.0.0.1:#{remote_port}#{health_path}"
    ok, output = remote_capture(
      remote_host,
      "curl -s -o /dev/null -w '%{http_code}' #{Shellwords.escape(url)}"
    )
    [ ok && output == "200", output ]
  end

  add_check(checks, "public health check") do
    ok, output = capture("curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", public_url)
    [ ok && output == "200", output ]
  end
end

failures = checks.reject(&:ok)

checks.each do |check|
  marker = check.ok ? "OK" : "FAIL"
  puts "#{marker.ljust(5)} #{check.name}"
  puts check.detail.lines.map { |line| "      #{line}" }.join unless check.detail.to_s.empty?
end

puts

if failures.empty?
  puts "Deploy doctor passed."
  exit 0
end

puts "Deploy doctor found #{failures.length} issue(s)."
exit(report_only ? 0 : 1)
