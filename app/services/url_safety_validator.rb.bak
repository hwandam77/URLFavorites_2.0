require "uri"
require "ipaddr"

class UrlSafetyValidator
  BLOCKED_HOSTS = %w[localhost].freeze

  def self.call(url)
    return false unless url.is_a?(String) && url.match?(/\Ahttps?:\/\//i)

    uri = URI.parse(url)

    # Check host
    host = uri.host&.gsub(/\[|\]/, "")
    return false if host.nil? || host.empty?
    return false if BLOCKED_HOSTS.include?(host.downcase)

    # Check IP addresses
    begin
      ip = IPAddr.new(host)
      return false if ip.private? || ip.loopback?
    rescue IPAddr::InvalidAddressError
      # Not an IP address — hostname is allowed
    end

    true
  rescue URI::InvalidURIError
    false
  end
end
