<nav class="sidebar flex flex-col h-full"
     style="width:240px;background:var(--color-surface);border-right:1px solid var(--color-border);--text-xs:14px;font-size:17px;"
     data-sidebar-target="sidebar">

  <%# 브랜드 %>
  <div class="flex items-center gap-2.5 px-5 py-5" style="border-bottom:1px solid var(--color-border);">
    <div class="flex items-center justify-center w-7 h-7 rounded-sm"
         style="background:var(--color-accent-muted);border:1px solid var(--color-border-strong);">
      <svg class="w-3.5 h-3.5" fill="none" style="color:var(--color-accent-text);" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
      </svg>
    </div>
    <div>
      <span style="font-size:17px;font-weight:650;letter-spacing:-0.02em;color:var(--color-text);">URLFAV</span>
      <span style="font-size:12px;font-weight:500;color:var(--color-text-tertiary);margin-left:4px;">v2.0</span>
    </div>
  </div>

  <%# URL 추가 (모바일) %>
  <div class="px-3 pt-4 pb-2 md:hidden">
    <%= form_with url: favorites_path, method: :post do |f| %>
      <div class="flex gap-2">
        <%= f.text_field :url, name: "favorite[url]",
          placeholder: "URL 입력...",
          style: "
            flex:1;
            background:var(--color-bg);
            border:1px solid var(--color-border);
            border-radius:var(--radius-md);
            padding:8px 12px;
            font-size:var(--text-sm);
            color:var(--color-text);
            outline:none;
          " %>
        <%= f.submit "+",
          style: "
            background:var(--color-accent);
            color:#fff;
            width:36px;height:36px;
            border-radius:var(--radius-md);
            font-size:16px;font-weight:700;
            cursor:pointer;border:none;
          " %>
      </div>
    <% end %>
  </div>

  <%# 메인 네비게이션 %>
  <div class="px-3 pt-4 space-y-0.5">
    <p style="font-size:var(--text-xs);font-weight:600;letter-spacing:0.8px;color:var(--color-text-tertiary);text-transform:uppercase;padding:0 12px 8px;">탐색</p>

    <% current_ct = params[:content_type] %>
    <%
      type_nav = [
        { label: "전체",   ct: nil,       icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>' },
        { label: "웹",     ct: "webpage", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/>' },
        { label: "YouTube", ct: "youtube", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>' },
        { label: "GitHub",  ct: "github",  icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>' },
      ]
    %>

    <% type_nav.each do |item| %>
      <% is_active = (item[:ct].nil? && current_ct.blank?) || current_ct == item[:ct] %>
      <% link_style = is_active ? "background:var(--color-accent-muted);color:var(--color-accent-text);font-weight:600;" : "color:var(--color-text-secondary);" %>
      <%= link_to favorites_path(content_type: item[:ct]),
            class: "flex items-center gap-2.5 px-3 py-2 rounded-md transition-all",
            style: link_style,
            onmouseover: "this.style.background='var(--color-accent-muted)'",
            onmouseout: "this.style.background='#{is_active ? "var(--color-accent-muted)" : "transparent"}'" do
      %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
          <%= item[:icon].html_safe %>
        </svg>
        <%= item[:label] %>
      <% end %>
    <% end %>
  </div>

  <%# 컬렉션 %>
  <% if @collections.present? %>
    <div class="px-3 pt-6 pb-1">
      <p style="font-size:var(--text-xs);font-weight:600;letter-spacing:0.8px;color:var(--color-text-tertiary);text-transform:uppercase;padding:0 12px 8px;">컬렉션</p>
    </div>
    <div class="px-3 space-y-0.5 pb-3">
      <% @collections.each do |collection| %>
        <%= link_to collection_path(collection),
              class: "flex items-center gap-2.5 px-3 py-1.5 rounded-md transition-all",
              style: "color:var(--color-text-secondary);" do
        %>
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background:var(--color-accent);"></span>
          <span class="truncate"><%= collection.name %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# 스페이서 %>
  <div class="flex-1"></div>

  <%# 다크/라이트 모드 토글 %>
  <div class="px-3 py-4" style="border-top:1px solid var(--color-border);">
    <button type="button"
            onclick="(function(){var h=document.documentElement;if(h.classList.contains('dark')){h.classList.remove('dark');h.classList.add('sepia');localStorage.setItem('theme','sepia');}else if(h.classList.contains('sepia')){h.classList.remove('sepia');localStorage.removeItem('theme');}else{h.classList.add('dark');localStorage.setItem('theme','dark');}})()"
            class="flex items-center gap-2.5 w-full px-3 py-2 rounded-md transition-all"
            style="color:var(--color-text-secondary);background:transparent;"
            onmouseover="this.style.background='var(--color-surface-hover)'"
            onmouseout="this.style.background='transparent'">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
        <path class="dark-icon" stroke-linecap="round" stroke-linejoin="round"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
      </svg>
      <span>테마 전환</span>
    </button>
  </div>
</nav>
