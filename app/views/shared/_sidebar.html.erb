<nav class="sidebar flex flex-col h-full"
     style="width:220px;background:var(--color-surface);border-right:1px solid var(--color-border);"
     data-sidebar-target="sidebar">

  <%# 브랜드 %>
  <div class="flex items-center gap-2.5 px-5 py-5" style="border-bottom:1px solid var(--color-border);">
    <div class="flex items-center justify-center w-7 h-7 rounded-md"
         style="background:var(--color-accent);">
      <svg class="w-3.5 h-3.5" fill="none" stroke="#fff" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
      </svg>
    </div>
    <div>
      <span style="font-size:14px;font-weight:700;letter-spacing:-0.3px;color:var(--color-text);">URLFAV</span>
      <span style="font-size:10px;font-weight:500;color:var(--color-text-tertiary);margin-left:4px;">v2.0</span>
    </div>
  </div>

  <%# URL 추가 (모바일) %>
  <div class="px-3 pt-4 pb-2 md:hidden">
    <%= form_with url: favorites_path, method: :post do |f| %>
      <div class="flex gap-2">
        <%= f.text_field :url, name: "favorite[url]",
          placeholder: "URL 입력...",
          style: "
            flex:1;
            background:var(--color-bg);
            border:1px solid var(--color-border);
            border-radius:var(--radius-md);
            padding:8px 12px;
            font-size:var(--text-sm);
            color:var(--color-text);
            outline:none;
          " %>
        <%= f.submit "+",
          style: "
            background:var(--color-accent);
            color:#fff;
            width:36px;height:36px;
            border-radius:var(--radius-md);
            font-size:16px;font-weight:700;
            cursor:pointer;border:none;
          " %>
      </div>
    <% end %>
  </div>

  <%# 메인 네비게이션 %>
  <div class="px-3 pt-4 space-y-0.5">
    <p style="font-size:var(--text-xs);font-weight:600;letter-spacing:0.8px;color:var(--color-text-tertiary);text-transform:uppercase;padding:0 12px 8px;">탐색</p>

    <% current_path = request.path %>
    <% current_params = params.except(:page).to_unsafe_h %>
    <% is_favorites_active = current_path == favorites_path && current_params.except(:q, :sort, :content_type, :status).empty? %>

    <%= link_to favorites_path,
          class: "flex items-center gap-2.5 px-3 py-2 rounded-md text-sm transition-all",
          style: is_favorites_active ? "background:var(--color-accent-muted);color:var(--color-accent-text);font-weight:600;" : "color:var(--color-text-secondary);",
          data: { turbo_frame: "_self" } do
    %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
      </svg>
      전체 북마크
    <% end %>

    <%= link_to favorites_path(pinned: true),
          class: "flex items-center gap-2.5 px-3 py-2 rounded-md text-sm transition-all",
          style: "color:var(--color-text-secondary);" do
    %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
      </svg>
      즐겨찾기
    <% end %>

    <%= link_to favorites_path(archived: true),
          class: "flex items-center gap-2.5 px-3 py-2 rounded-md text-sm transition-all",
          style: "color:var(--color-text-secondary);" do
    %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
      </svg>
      아카이브
    <% end %>
  </div>

  <%# 컬렉션 %>
  <% if @collections.present? %>
    <div class="px-3 pt-6 pb-1">
      <p style="font-size:var(--text-xs);font-weight:600;letter-spacing:0.8px;color:var(--color-text-tertiary);text-transform:uppercase;padding:0 12px 8px;">컬렉션</p>
    </div>
    <div class="px-3 space-y-0.5 pb-3">
      <% @collections.each do |collection| %>
        <%= link_to collection_path(collection),
              class: "flex items-center gap-2.5 px-3 py-1.5 rounded-md text-sm transition-all",
              style: "color:var(--color-text-secondary);" do
        %>
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background:var(--color-accent);"></span>
          <span class="truncate"><%= collection.name %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# 스페이서 %>
  <div class="flex-1"></div>

  <%# 다크/라이트 모드 토글 %>
  <div class="px-3 py-4" style="border-top:1px solid var(--color-border);">
    <button type="button"
            data-controller="theme"
            data-action="click->theme#toggle"
            class="flex items-center gap-2.5 w-full px-3 py-2 rounded-md text-sm transition-all"
            style="color:var(--color-text-secondary);"
            onmouseover="this.style.background='var(--color-surface-hover)'"
            onmouseout="this.style.background='transparent'">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
        <path class="dark-icon" stroke-linecap="round" stroke-linejoin="round"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
      </svg>
      <span>테마 전환</span>
    </button>
  </div>
</nav>
