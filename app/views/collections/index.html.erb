<div class="max-w-4xl mx-auto px-6 py-10">

  <%# 헤더 %>
  <div class="mb-8">
    <h1 style="font-size:var(--text-2xl);font-weight:700;letter-spacing:-0.5px;color:var(--color-text);">컬렉션</h1>
    <p style="font-size:var(--text-sm);color:var(--color-text-tertiary);margin-top:4px;">관련 북마크를 그룹으로 관리합니다</p>
  </div>

  <%# 새 컬렉션 폼 %>
  <div class="mb-8 p-4 rounded-lg" style="background:var(--color-surface);border:1px solid var(--color-border);">
    <%= form_with url: collections_path, method: :post, class: "flex gap-3" do |f| %>
      <%= f.text_field :name, name: "collection[name]",
        placeholder: "새 컬렉션 이름...",
        style: "flex:1;border:1px solid var(--color-border);border-radius:var(--radius-md);padding:9px 14px;font-size:var(--text-sm);color:var(--color-text);background:var(--color-bg);outline:none;" %>
      <button type="submit"
        style="background:var(--color-accent);color:#fff;border-radius:var(--radius-md);padding:9px 20px;font-size:var(--text-sm);font-weight:600;cursor:pointer;border:none;transition:background 0.2s;"
        onmouseover="this.style.background='var(--color-accent-hover)'"
        onmouseout="this.style.background='var(--color-accent)'">만들기</button>
    <% end %>
  </div>

  <% if @collections.any? %>
    <div class="space-y-3">
      <% @collections.each do |collection| %>
        <div class="flex items-center justify-between p-4 rounded-lg transition-all"
             style="background:var(--color-surface);border:1px solid var(--color-border);"
             onmouseover="this.style.borderColor='var(--color-accent-muted)'"
             onmouseout="this.style.borderColor='var(--color-border)'">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-2 h-2 rounded-full flex-shrink-0" style="background:var(--color-accent);"></div>
            <div class="min-w-0">
              <%= link_to collection.name, collection_path(collection),
                    class: "block transition-colors",
                    style: "font-size:var(--text-base);font-weight:600;color:var(--color-text);",
                    onmouseover: "this.style.color='var(--color-accent)'",
                    onmouseout: "this.style.color='var(--color-text)'" %>
              <div class="flex items-center gap-2 mt-1">
                <% if collection.description.present? %>
                  <span style="font-size:var(--text-xs);color:var(--color-text-tertiary);"><%= collection.description %></span>
                  <span style="color:var(--color-border);">·</span>
                <% end %>
                <span style="font-size:var(--text-xs);color:var(--color-text-tertiary);"><%= collection.favorites.count %>개</span>
              </div>
            </div>
          </div>
          <%= button_to "삭제", collection_path(collection), method: :delete,
            data: { turbo_confirm: "컬렉션을 삭제하시겠습니까?" },
            class: "transition-colors",
            style: "color:var(--color-text-tertiary);font-size:var(--text-xs);background:none;border:1px solid var(--color-border);cursor:pointer;padding:5px 12px;border-radius:var(--radius-md);",
            onmouseover: "this.style.borderColor='var(--color-failed-border)';this.style.color='var(--color-failed-text)';this.style.background='var(--color-failed-bg)'",
            onmouseout: "this.style.borderColor='var(--color-border)';this.style.color='var(--color-text-tertiary)';this.style.background='none'" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="py-20 text-center">
      <div class="mb-4 flex items-center justify-center w-12 h-12 mx-auto rounded-xl" style="background:var(--color-accent-muted);">
        <svg class="w-5 h-5" fill="none" stroke="var(--color-accent)" viewBox="0 0 24 24" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
      </div>
      <p style="font-size:var(--text-sm);color:var(--color-text-tertiary);">컬렉션이 없습니다. 위에서 만들어보세요.</p>
    </div>
  <% end %>
</div>
