<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-4">
    <%= link_to "← 컬렉션으로 돌아가기", collections_path, style: "color:var(--color-accent);font-size:14px;font-weight:500;" %>
  </div>

  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 style="font-size:24px;font-weight:700;letter-spacing:-0.5px;color:var(--color-text);"><%= @collection.name %></h1>
      <% if @collection.description.present? %>
        <p style="font-size:14px;color:var(--color-text-muted);margin-top:4px;"><%= @collection.description %></p>
      <% end %>
    </div>
  </div>

  <% if @favorites.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @favorites.each do |favorite| %>
        <%= render partial: "favorites/favorite_card", locals: { favorite: favorite } %>
      <% end %>
    </div>
  <% else %>
    <div style="text-align:center;padding:48px 24px;">
      <p style="font-size:16px;color:var(--color-text-muted);">이 컬렉션에 즐겨찾기가 없습니다.</p>
    </div>
  <% end %>
</div>
