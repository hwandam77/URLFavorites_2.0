<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-4">
    <%= link_to "← Back to Collections", collections_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @collection.name %></h1>
      <% if @collection.description.present? %>
        <p class="text-gray-500 mt-1"><%= @collection.description %></p>
      <% end %>
    </div>
  </div>

  <% if @favorites.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @favorites.each do |favorite| %>
        <%= render partial: "favorites/favorite_card", locals: { favorite: favorite } %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-gray-500">No favorites in this collection yet.</p>
    </div>
  <% end %>
</div>
