<% content_for :title, "로그인" %>

<div class="min-h-full flex items-center justify-center px-4 py-10">
  <section class="w-full max-w-sm rounded-lg p-5"
           style="background:var(--color-command-bg);border:1px solid var(--color-border);box-shadow:var(--shadow-md);backdrop-filter:blur(18px);">
    <div class="mb-5">
      <div class="mb-2 flex items-center gap-2">
        <span style="height:8px;width:8px;border-radius:var(--radius-full);background:var(--color-accent);display:inline-block;"></span>
        <span style="font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);font-weight:700;color:var(--color-accent-text);text-transform:uppercase;">URLFAV Access</span>
      </div>
      <h1 style="font-size:var(--text-2xl);font-weight:700;letter-spacing:0;color:var(--color-text);line-height:1.15;">로그인</h1>
    </div>

    <%= form_with url: session_path, scope: :session, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, "이메일",
          style: "display:block;margin-bottom:var(--space-2);font-size:var(--text-sm);font-weight:700;color:var(--color-text-secondary);" %>
        <%= form.email_field :email_address,
          required: true,
          autofocus: true,
          autocomplete: "username",
          placeholder: "you@example.com",
          style: "
            width:100%;
            background:var(--color-surface);
            border:1px solid var(--color-border);
            border-radius:var(--radius-md);
            padding:11px 12px;
            font-size:var(--text-sm);
            font-weight:500;
            color:var(--color-text);
            outline:none;
          " %>
      </div>

      <div>
        <%= form.label :password, "비밀번호",
          style: "display:block;margin-bottom:var(--space-2);font-size:var(--text-sm);font-weight:700;color:var(--color-text-secondary);" %>
        <%= form.password_field :password,
          required: true,
          autocomplete: "current-password",
          style: "
            width:100%;
            background:var(--color-surface);
            border:1px solid var(--color-border);
            border-radius:var(--radius-md);
            padding:11px 12px;
            font-size:var(--text-sm);
            font-weight:500;
            color:var(--color-text);
            outline:none;
          " %>
      </div>

      <%= form.submit "로그인",
        style: "
          width:100%;
          background:var(--color-accent);
          color:#fff;
          border:none;
          border-radius:var(--radius-md);
          padding:11px 14px;
          font-size:var(--text-sm);
          font-weight:800;
          cursor:pointer;
        ",
        onmouseover: "this.style.background='var(--color-accent-hover)'",
        onmouseout: "this.style.background='var(--color-accent)'" %>
    <% end %>
  </section>
</div>
