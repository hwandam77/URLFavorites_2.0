<%
  status_style = case favorite.status
    when "pending"   then "background:var(--color-tag-bg);color:var(--color-tag-text);"
    when "analyzing" then "background:var(--color-tag-bg);color:var(--color-tag-text);animation:animate-pulse 2s infinite;"
    when "done"      then "background:#dcfce7;color:#166534;"
    when "failed"    then "background:#fef2f2;color:#991b1b;"
    else                  "background:var(--color-surface);color:var(--color-text-muted);"
  end
  status_label = case favorite.status
    when "pending" then "대기중" when "analyzing" then "분석중"
    when "done" then "완료" when "failed" then "실패"
    else favorite.status
  end

  # Favicon URL (Google Favicon API)
  favicon_url = "https://www.google.com/s2/favicons?domain=#{URI.parse(favorite.url).host rescue favorite.url}&sz=32"

  # Description from analysis
  description = favorite.analysis&.description.presence
  excerpt = favorite.analysis&.excerpt.presence
  display_text = description || excerpt
%>
<div style="background:var(--color-surface);border:var(--color-border) 1px solid;border-radius:12px;padding:16px;transition:box-shadow 0.15s;position:relative;"
     class="hover:shadow-md group">
  <%# Action Menu %>
  <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity" data-controller="action-menu">
    <button type="button"
            data-action="action-menu#toggle"
            class="p-1.5 rounded-md hover:bg-black/5 dark:hover:bg-white/10"
            style="color:var(--color-text-muted);">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <circle cx="12" cy="6" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="18" r="2"/>
      </svg>
    </button>
    <div class="hidden absolute right-0 top-full mt-1 w-40 bg-white dark:bg-stone-800 rounded-lg shadow-lg border py-1 z-10"
         style="border-color:var(--color-border);"
         data-action-menu-target="menu">
      <%= link_to favorite_path(favorite, format: :turbo_stream),
            method: :delete,
            data: { action_menu_target: "menuItem", action: "action-menu#close", confirm: "삭제하시겠습니까?" },
            class: "flex items-center gap-2 px-3 py-2 text-sm hover:bg-black/5 dark:hover:bg-white/10" do %>
        <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        삭제
      <% end %>
      <button type="button"
              data-action="action-menu#close click->clipboard#copy"
              data-clipboard-url="<%= favorite.url %>"
              class="flex items-center gap-2 px-3 py-2 text-sm hover:bg-black/5 dark:hover:bg-white/10 w-full">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
        </svg>
        URL 복사
      </button>
    </div>
  </div>

  <%= link_to favorite_path(favorite), class: "block" do %>
    <%# Header: Favicon + Title %>
    <div class="flex items-start gap-3 mb-3">
      <img src="<%= favicon_url %>"
           alt=""
           class="w-6 h-6 mt-0.5 rounded-sm flex-shrink-0"
           onerror="this.style.display='none'">
      <h3 style="font-size:16px;font-weight:600;letter-spacing:-0.3px;color:var(--color-text);line-height:1.3;" class="truncate flex-1">
        <%= favorite.title.presence || "제목 없음" %>
      </h3>
    </div>

    <%# URL %>
    <p style="font-size:12px;color:var(--color-text-muted);margin-bottom:8px;line-height:1.4;" class="truncate">
      <%= favorite.url %>
    </p>

    <%# Description excerpt %>
    <% if display_text %>
      <p style="font-size:13px;color:var(--color-text-muted);line-height:1.5;margin-bottom:12px;" class="line-clamp-2">
        <%= display_text %>
      </p>
    <% end %>

    <%# Footer: Status + Content Type + Tags %>
    <div class="flex items-center gap-2 flex-wrap">
      <span style="<%= status_style %>padding:2px 8px;border-radius:9999px;font-size:11px;font-weight:600;">
        <%= status_label %>
      </span>
      <span style="font-size:11px;color:var(--color-text-muted);">
        <%= favorite.content_type == "youtube" ? "YouTube" : "웹" %>
      </span>
      <% if favorite.analysis&.tags.present? %>
        <% favorite.analysis.tags.first(3).each do |tag| %>
          <span style="background:var(--color-tag-bg);color:var(--color-tag-text);padding:2px 8px;border-radius:9999px;font-size:11px;font-weight:500;">
            <%= tag %>
          </span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
