<%
  status_map = {
    "pending"   => { bg: "var(--color-pending-bg)", text: "var(--color-pending-text)", border: "var(--color-pending-border)", label: "대기" },
    "analyzing" => { bg: "var(--color-analyzing-bg)", text: "var(--color-analyzing-text)", border: "var(--color-analyzing-border)", label: "분석중", pulse: true },
    "done"      => { bg: "var(--color-done-bg)", text: "var(--color-done-text)", border: "var(--color-done-border)", label: "완료" },
    "failed"    => { bg: "var(--color-failed-bg)", text: "var(--color-failed-text)", border: "var(--color-failed-border)", label: "실패" },
  }
  s = status_map[favorite.status] || { bg: "var(--color-surface)", text: "var(--color-text-tertiary)", border: "var(--color-border)", label: favorite.status }

  host = URI.parse(favorite.url).host rescue nil
  domain = host&.sub(/^www\./, "") || favorite.url
  favicon_url = "https://www.google.com/s2/favicons?domain=#{host || favorite.url}&sz=32"

  summary = favorite.analysis&.summary.presence
  tags = favorite.analysis&.tags
%>

<div id="<%= dom_id(favorite) %>" class="group relative rounded-lg overflow-hidden transition-all duration-200"
     style="background:var(--color-surface);border:1px solid var(--color-border);"
     onmouseover="this.style.borderColor='var(--color-accent-muted)';this.style.boxShadow='var(--shadow-md)'"
     onmouseout="this.style.borderColor='var(--color-border)';this.style.boxShadow='none'">

  <%# 상단: YouTube 썸네일 or 액센트 라인 %>
  <% if favorite.content_type == "youtube" && favorite.thumbnail_url.present? %>
    <div class="relative overflow-hidden" style="height:120px;">
      <img src="<%= favorite.thumbnail_url %>"
           alt="YouTube thumbnail"
           class="w-full h-full object-cover"
           loading="lazy">
      <div style="position:absolute;inset:0;background:linear-gradient(to bottom, transparent 40%, var(--color-surface) 100%);"></div>
      <span style="position:absolute;bottom:6px;left:8px;background:rgba(0,0,0,0.7);color:#fff;padding:2px 7px;border-radius:var(--radius-sm);font-size:var(--text-xs);font-weight:600;">▶ YouTube</span>
    </div>
  <% else %>
    <div style="height:2px;background:var(--color-accent);"></div>
  <% end %>

  <%# 액션 메뉴 %>
  <div class="absolute top-4 right-3 opacity-0 group-hover:opacity-100 transition-opacity z-10" data-controller="action-menu">
    <button type="button"
            data-action="action-menu#toggle"
            class="p-1.5 rounded-md transition-colors"
            style="color:var(--color-text-tertiary);background:var(--color-surface-raised);border:1px solid var(--color-border);"
            onmouseover="this.style.background='var(--color-surface-hover)'"
            onmouseout="this.style.background='var(--color-surface-raised)'">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <circle cx="12" cy="6" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="18" r="1.5"/>
      </svg>
    </button>
    <div class="hidden absolute right-0 top-full mt-1 w-40 rounded-lg py-1 z-20"
         style="background:var(--color-surface-raised);border:1px solid var(--color-border);box-shadow:var(--shadow-lg);">
      <%# 핀 토글 %>
      <%= button_to toggle_pin_favorite_path(favorite, format: :turbo_stream),
            method: :post,
            data: { action_menu_target: "menuItem", action: "action-menu#close" },
            class: "flex items-center gap-2.5 px-3 py-2 text-sm w-full transition-colors",
            style: "color:var(--color-text-secondary);" do %>
        <svg class="w-3.5 h-3.5 <%= favorite.pinned? ? 'text-yellow-500' : '' %>" fill="<%= favorite.pinned? ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
        </svg>
        <%= favorite.pinned? ? "핀 해제" : "핀 등록" %>
      <% end %>
      <%= link_to favorite_path(favorite, format: :turbo_stream), method: :delete, data: { action_menu_target: "menuItem", action: "action-menu#close", confirm: "삭제하시겠습니까?" }, class: "flex items-center gap-2.5 px-3 py-2 text-sm transition-colors", style: "color:var(--color-text-secondary);" do %>
        <svg class="w-3.5 h-3.5" style="color:var(--color-failed-text);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        삭제
      <% end %>
      <button type="button"
              data-action="action-menu#close click->clipboard#copy"
              data-clipboard-url="<%= favorite.url %>"
              class="flex items-center gap-2.5 px-3 py-2 text-sm w-full transition-colors"
              style="color:var(--color-text-secondary);">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
        </svg>
        URL 복사
      </button>
    </div>
  </div>

  <%= link_to favorite_path(favorite), class: "block p-4" do %>
    <%# 파비콘 + 제목 %>
    <div class="flex items-start gap-3 mb-2.5">
      <img src="<%= favicon_url %>"
           alt=""
           class="w-4 h-4 mt-1 rounded flex-shrink-0"
           onerror="this.style.display='none'"
           loading="lazy">
      <% display_title = favorite.url.to_s.include?("github.com") ? github_repo_name(favorite.url) : (favorite.title.presence || "제목 없음") %>
      <h3 style="font-size:var(--text-base);font-weight:600;letter-spacing:-0.2px;color:var(--color-text);line-height:1.4;" class="line-clamp-2 flex-1 pr-6">
        <%= display_title %>
      </h3>
    </div>

    <%# 도메인 %>
    <p style="font-size:var(--text-xs);font-weight:500;color:var(--color-text-tertiary);margin-bottom:10px;" class="truncate">
      <%= domain %>
    </p>

    <%# 요약 %>
    <% if summary %>
      <p style="font-size:17px;color:var(--color-text-secondary);line-height:1.55;margin-bottom:12px;" class="line-clamp-2">
        <%= summary %>
      </p>
    <% end %>

    <%# 하단: 상태 + 유형 + 태그 %>
    <div class="flex items-center gap-2 flex-wrap">
      <span style="background:<%= s[:bg] %>;color:<%= s[:text] %>;border:1px solid <%= s[:border] %>;padding:2px 8px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:600;<%= s[:pulse] ? 'animation:animate-pulse 2s infinite;' : '' %>">
        <%= s[:label] %>
      </span>
      <span style="font-size:var(--text-xs);font-weight:500;color:var(--color-text-tertiary);">
        <%= favorite.content_type == "youtube" ? "▶ YouTube" : "Web" %>
      </span>
      <% if tags.present? %>
        <% tags.first(2).each do |tag| %>
          <span style="color:var(--color-accent-text);padding:1px 0;font-size:var(--text-xs);font-weight:500;">
            #<%= tag %>
          </span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
