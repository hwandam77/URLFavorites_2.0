<%
  status_style = case favorite.status
    when "pending"   then "background:var(--color-tag-bg);color:var(--color-tag-text);"
    when "analyzing" then "background:var(--color-tag-bg);color:var(--color-tag-text);animation:animate-pulse 2s infinite;"
    when "done"      then "background:var(--color-success-bg);color:var(--color-success-text);border:1px solid var(--color-success-border);"
    when "failed"    then "background:var(--color-error-bg);color:var(--color-error-text);border:1px solid var(--color-error-border);"
    else                  "background:var(--color-surface);color:var(--color-text-muted);"
  end
  status_label = case favorite.status
    when "pending" then "대기중" when "analyzing" then "분석중"
    when "done" then "완료" when "failed" then "실패"
    else favorite.status
  end

  host = URI.parse(favorite.url).host rescue nil
  domain = host&.sub(/^www\./, "") || favorite.url
  favicon_url = "https://www.google.com/s2/favicons?domain=#{host || favorite.url}&sz=32"

  summary = favorite.analysis&.summary.presence
%>
<div style="background:var(--color-surface);border:1px solid var(--color-border);border-left:4px solid var(--color-accent);border-radius:0 12px 12px 0;padding:var(--space-4);transition:box-shadow 0.2s ease,transform 0.18s cubic-bezier(0.16,1,0.3,1),border-color 0.2s ease;position:relative;"
     class="hover:shadow-md hover:-translate-y-0.5 group">

  <%# Action Menu %>
  <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity" data-controller="action-menu">
    <button type="button"
            data-action="action-menu#toggle"
            class="p-1.5 rounded-md hover:bg-black/5 dark:hover:bg-white/10"
            style="color:var(--color-text-muted);">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <circle cx="12" cy="6" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="18" r="2"/>
      </svg>
    </button>
    <div class="hidden absolute right-0 top-full mt-1 w-44 rounded-lg shadow-lg py-1 z-10"
         style="background:var(--color-surface);border:1px solid var(--color-border);"
         data-action-menu-target="menu">
      <%= link_to favorite_path(favorite, format: :turbo_stream),
            method: :delete,
            data: { action_menu_target: "menuItem", action: "action-menu#close", confirm: "삭제하시겠습니까?" },
            class: "flex items-center gap-2.5 px-3 py-2 text-sm transition-colors hover:bg-black/5 dark:hover:bg-white/10",
            style: "color:var(--color-text);" do %>
        <svg class="w-3.5 h-3.5" style="color:#ef4444;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        삭제
      <% end %>
      <button type="button"
              data-action="action-menu#close click->clipboard#copy"
              data-clipboard-url="<%= favorite.url %>"
              class="flex items-center gap-2.5 px-3 py-2 text-sm w-full transition-colors hover:bg-black/5 dark:hover:bg-white/10"
              style="color:var(--color-text);">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
        </svg>
        URL 복사
      </button>
    </div>
  </div>

  <%= link_to favorite_path(favorite), class: "block" do %>
    <%# Header: Favicon + Title %>
    <div class="flex items-start gap-3 mb-2.5">
      <img src="<%= favicon_url %>"
           alt=""
           class="w-5 h-5 mt-0.5 rounded flex-shrink-0"
           onerror="this.style.display='none'">
      <h3 style="font-size:15px;font-weight:700;letter-spacing:-0.4px;color:var(--color-text);line-height:1.3;" class="line-clamp-2 flex-1 pr-6">
        <%= favorite.title.presence || "제목 없음" %>
      </h3>
    </div>

    <%# Domain badge %>
    <p style="font-size:11px;font-weight:500;color:var(--color-text-muted);margin-bottom:10px;letter-spacing:0.1px;" class="truncate">
      <%= domain %>
    </p>

    <%# Summary excerpt %>
    <% if summary %>
      <p style="font-size:13px;color:var(--color-text-muted);line-height:1.55;margin-bottom:12px;" class="line-clamp-2">
        <%= summary %>
      </p>
    <% end %>

    <%# Footer: Status + Type + Tags %>
    <div class="flex items-center gap-1.5 flex-wrap">
      <span style="<%= status_style %>padding:2px 7px;border-radius:9999px;font-size:10px;font-weight:700;letter-spacing:0.2px;">
        <%= status_label %>
      </span>
      <span style="font-size:10px;color:var(--color-text-muted);font-weight:500;">
        <%= favorite.content_type == "youtube" ? "▶ YouTube" : "⬡ 웹" %>
      </span>
      <% if favorite.analysis&.tags.present? %>
        <% favorite.analysis.tags.first(3).each do |tag| %>
          <span style="background:var(--color-tag-bg);color:var(--color-tag-text);padding:2px 7px;border-radius:9999px;font-size:10px;font-weight:600;">
            #<%= tag %>
          </span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
