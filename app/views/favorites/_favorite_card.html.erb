<%
  status_style = case favorite.status
    when "pending"   then "background:#fffbeb;color:#92400e;"
    when "analyzing" then "background:var(--notion-badge-bg);color:var(--notion-badge-text);animation:animate-pulse 2s infinite;"
    when "done"      then "background:#f0fdf4;color:#166534;"
    when "failed"    then "background:#fef2f2;color:#991b1b;"
    else                  "background:rgba(0,0,0,0.05);color:var(--notion-gray-500);"
  end
  status_label = case favorite.status
    when "pending" then "대기중" when "analyzing" then "분석중"
    when "done" then "완료" when "failed" then "실패"
    else favorite.status
  end
%>
<div style="background:#fff;border:var(--notion-border);border-radius:12px;box-shadow:var(--notion-shadow);padding:16px;transition:box-shadow 0.15s;"
     class="hover:shadow-md">
  <%= link_to favorite_path(favorite), class: "block" do %>
    <h3 style="font-size:15px;font-weight:600;letter-spacing:-0.125px;color:var(--notion-black);margin-bottom:4px;" class="truncate">
      <%= favorite.title.presence || "제목 없음" %>
    </h3>
    <p style="font-size:13px;color:var(--notion-gray-500);margin-bottom:10px;" class="truncate">
      <%= favorite.url %>
    </p>
    <div class="flex items-center gap-2">
      <span style="<%= status_style %>padding:2px 8px;border-radius:9999px;font-size:12px;font-weight:600;letter-spacing:0.125px;">
        <%= status_label %>
      </span>
      <span style="font-size:12px;color:var(--notion-gray-300);">
        <%= favorite.content_type == "youtube" ? "YouTube" : "웹" %>
      </span>
    </div>
    <% if favorite.analysis&.tags.present? %>
      <div class="flex flex-wrap gap-1 mt-3">
        <% favorite.analysis.tags.first(3).each do |tag| %>
          <span style="background:var(--notion-warm-white);color:var(--notion-gray-500);padding:2px 8px;border-radius:9999px;font-size:12px;font-weight:500;border:var(--notion-border);">
            <%= tag %>
          </span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
