<%= turbo_stream_from :favorites %>
<%
  favorites_for_stats = @favorites.respond_to?(:to_a) ? @favorites.to_a : Array(@favorites)
  total_count = @favorites.respond_to?(:count) ? @favorites.count : favorites_for_stats.length
  done_count = favorites_for_stats.count { |favorite| favorite.status == "done" }
  analyzing_count = favorites_for_stats.count { |favorite| favorite.status == "analyzing" }
  failed_count = favorites_for_stats.count { |favorite| favorite.status == "failed" }
  youtube_count = favorites_for_stats.count { |favorite| favorite.content_type == "youtube" }
  latest_ai_favorite = favorites_for_stats.find { |favorite| favorite.analysis.present? } || favorites_for_stats.first
  rail_content_type = params[:content_type].presence || latest_ai_favorite&.content_type
  rail_context_favorites = favorites_for_stats.select do |favorite|
    favorite.analysis.present? && (rail_content_type.blank? || favorite.content_type == rail_content_type)
  end.first(4)
  current_view_mode = @view_mode == "list" ? "list" : "card"
%>

<div class="mx-auto px-4 py-5 lg:px-6 lg:py-6" style="max-width:1480px;">
  <header class="urlf-workspace-header mb-5">
    <div>
      <div class="mb-2 flex items-center gap-2">
        <span style="height:8px;width:8px;border-radius:var(--radius-full);background:var(--color-accent);display:inline-block;"></span>
        <span style="font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);font-weight:700;color:var(--color-accent-text);text-transform:uppercase;">Warm Command Archive</span>
      </div>
      <h1 style="font-size:var(--text-3xl);font-weight:650;letter-spacing:0;color:var(--color-text);line-height:1;margin-bottom:8px;">Bookmarks</h1>
      <p style="font-size:var(--text-sm);font-weight:500;color:var(--color-text-tertiary);">
        <span id="bookmark-count"><%= total_count %></span>개의 URL이 보관됨 · 분석 완료 <%= done_count %> · YouTube <%= youtube_count %>
      </p>
    </div>

    <aside class="urlf-desktop-rail rounded-md p-4" style="background:var(--color-command-bg);border:1px solid var(--color-border);box-shadow:var(--shadow-sm);">
      <div class="flex items-center justify-between" style="font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);font-weight:700;color:var(--color-text-tertiary);text-transform:uppercase;">
        <span>AI Context</span>
        <span style="color:var(--color-ai-accent);">quiet mode</span>
      </div>
      <p class="mt-3" style="font-size:var(--text-sm);line-height:1.55;color:var(--color-text-secondary);">
        분석 결과는 별도 마법 버튼이 아니라 검색, 필터, 카드 요약 안에서 바로 사용할 수 있게 정리됩니다.
      </p>
    </aside>
  </header>

  <section class="mb-3 grid gap-2 lg:grid-cols-2">
    <a href="https://ai-news-5min-kr.netlify.app/"
       target="_blank"
       rel="noopener noreferrer"
       class="group block overflow-hidden rounded-lg"
       style="background:var(--color-command-bg);border:1px solid var(--color-border);box-shadow:var(--shadow-sm);text-decoration:none;color:inherit;">
      <div class="grid h-full gap-2 p-2 md:grid-cols-[minmax(0,1fr)_auto] md:items-center" style="background:linear-gradient(120deg, var(--color-surface-raised), var(--color-ai-muted));">
        <div class="flex min-w-0 items-start gap-2">
          <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md" style="background:var(--color-accent);color:#fff;box-shadow:var(--shadow-sm);">
            <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-1.5">
              <span style="font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:750;color:var(--color-ai-accent);text-transform:uppercase;">Daily Signal</span>
              <span style="height:3px;width:3px;border-radius:var(--radius-full);background:var(--color-border);display:inline-block;"></span>
              <span style="font-size:10px;font-weight:700;color:var(--color-text-tertiary);">5분 AI 뉴스</span>
            </div>
            <h2 class="mt-0.5" style="font-size:var(--text-sm);font-weight:750;letter-spacing:0;color:var(--color-text);line-height:1.2;">
              오늘의 AI·테크 흐름을 빠르게 훑어보기
            </h2>
            <p class="mt-1 truncate-2" style="font-size:var(--text-xs);font-weight:500;line-height:1.35;color:var(--color-text-secondary);">
              데일리 AI 뉴스 리포트를 열고, 저장할 만한 기사와 도구 링크는 바로 URLFavorites에 보관하세요.
            </p>
          </div>
        </div>

        <div class="inline-flex items-center justify-between gap-2 rounded-md px-2 py-1 md:justify-center" style="background:var(--color-surface);border:1px solid var(--color-border);color:var(--color-accent-text);font-size:var(--text-xs);font-weight:750;">
          <span>뉴스 데스크 열기</span>
          <svg class="h-3 w-3 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h9v9"/>
          </svg>
        </div>
      </div>
    </a>

    <a href="https://vibelabs.kr/"
       target="_blank"
       rel="noopener noreferrer"
       class="group block overflow-hidden rounded-lg"
       style="text-decoration:none;color:inherit;">
      <div class="grid h-full gap-2 p-2 md:grid-cols-[minmax(0,1fr)_auto] md:items-center" style="background:var(--color-command-bg);border:1px solid var(--color-border);box-shadow:var(--shadow-sm);">
        <div class="flex min-w-0 items-start gap-2">
          <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md" style="background:var(--color-surface);border:1px solid var(--color-ai-accent);color:var(--color-ai-accent);box-shadow:var(--shadow-sm);font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);font-weight:800;">
            V
          </div>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-1.5">
              <span style="font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:750;color:var(--color-ai-accent);text-transform:uppercase;">Build Lab</span>
              <span style="height:3px;width:3px;border-radius:var(--radius-full);background:var(--color-border);display:inline-block;"></span>
              <span style="font-size:10px;font-weight:700;color:var(--color-text-tertiary);">VibeLabs</span>
            </div>
            <h2 class="mt-0.5" style="font-size:var(--text-sm);font-weight:750;letter-spacing:0;color:var(--color-text);line-height:1.2;">
              바이브 코딩 실전 자료와 커뮤니티 보기
            </h2>
            <p class="mt-1 truncate-2" style="font-size:var(--text-xs);font-weight:500;line-height:1.35;color:var(--color-text-secondary);">
              프로그램, Q&A, Lab 프로젝트를 확인하고 참고할 만한 빌드 사례를 북마크로 가져오세요.
            </p>
          </div>
        </div>

        <div class="inline-flex items-center justify-between gap-2 rounded-md px-2 py-1 md:justify-center" style="background:var(--color-surface);border:1px solid var(--color-border);color:var(--color-accent-text);font-size:var(--text-xs);font-weight:750;">
          <span>VibeLabs 열기</span>
          <svg class="h-3 w-3 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h9v9"/>
          </svg>
        </div>
      </div>
    </a>
  </section>

  <section class="sticky top-0 z-20 mb-5 rounded-lg p-3" style="background:var(--color-command-bg);border:1px solid var(--color-border);box-shadow:var(--shadow-md);backdrop-filter:blur(18px);">
    <div class="urlf-command-grid">
      <div id="url-form">
        <%= form_with url: favorites_path, method: :post, class: "flex gap-2" do |f| %>
          <%= f.text_field :url, name: "favorite[url]",
            placeholder: "분석할 URL 붙여넣기",
            style: "
              flex:1;
              min-width:0;
              background:var(--color-surface);
              border:1px solid var(--color-border);
              border-radius:var(--radius-md);
              padding:11px 12px;
              font-size:var(--text-sm);
              font-weight:500;
              color:var(--color-text);
              outline:none;
              transition:border-color 0.2s;
            " %>
          <%= f.submit "추가",
            style: "
              background:var(--color-accent);
              color:#fff;
              padding:0 16px;
              border-radius:var(--radius-md);
              font-size:var(--text-sm);
              font-weight:700;
              cursor:pointer;
              border:none;
            ",
            onmouseover: "this.style.background='var(--color-accent-hover)'",
            onmouseout: "this.style.background='var(--color-accent)'" %>
        <% end %>
      </div>

      <%= form_with url: favorites_path, method: :get, data: { turbo_frame: "favorites" } do %>
        <input type="hidden" name="content_type" value="<%= params[:content_type] %>">
        <input type="hidden" name="status" value="<%= params[:status] %>">
        <input type="hidden" name="sort" value="<%= params[:sort] %>">
        <input type="hidden" name="category" value="<%= params[:category] %>">
        <input type="hidden" name="view_mode" value="<%= current_view_mode %>">
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4" style="color:var(--color-text-tertiary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            type="text"
            name="q"
            value="<%= params[:q] %>"
            placeholder="자연어로 검색 · 예: 프롬프트로 바로 쓸 유튜브"
            data-controller="auto-submit"
            data-action="input->auto-submit#submit"
            style="width:100%;border:1px solid var(--color-border);border-radius:var(--radius-md);padding:11px 62px 11px 36px;font-size:var(--text-sm);font-weight:500;color:var(--color-text);background:var(--color-surface);outline:none;"
          >
          <span class="absolute right-3 top-1/2 -translate-y-1/2" style="font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:700;color:var(--color-text-tertiary);border:1px solid var(--color-border);border-radius:var(--radius-sm);padding:3px 6px;background:var(--color-surface-raised);">AI</span>
        </div>
      <% end %>

      <div class="flex items-center gap-2 justify-end">
        <%= form_with url: favorites_path, method: :get, class: "flex", data: { turbo_frame: "favorites", turbo_action: "replace" } do %>
          <input type="hidden" name="q" value="<%= params[:q] %>">
          <input type="hidden" name="content_type" value="<%= params[:content_type] %>">
          <input type="hidden" name="status" value="<%= params[:status] %>">
          <input type="hidden" name="category" value="<%= params[:category] %>">
          <input type="hidden" name="view_mode" value="<%= current_view_mode %>">
          <select name="sort"
            onchange="this.form.requestSubmit()"
            style="height:40px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);padding:0 12px;font-size:var(--text-sm);font-weight:600;color:var(--color-text-secondary);outline:none;cursor:pointer;">
            <option value="recent" <%= "selected" if params[:sort] == "recent" || params[:sort].blank? %>>최근 추가</option>
            <option value="oldest" <%= "selected" if params[:sort] == "oldest" %>>오래된 순</option>
            <option value="title" <%= "selected" if params[:sort] == "title" %>>제목 순</option>
          </select>
        <% end %>

        <div class="flex items-center gap-0.5 rounded-md" style="height:40px;background:var(--color-surface);border:1px solid var(--color-border);padding:4px;">
          <%= link_to favorites_path(request.query_parameters.merge(view_mode: "card")),
            data: { turbo: false },
            style: current_view_mode == "card" ?
              "padding:6px 10px;border-radius:var(--radius-sm);font-size:13px;font-weight:700;background:var(--color-accent);color:#fff;border:none;cursor:pointer;display:inline-flex;align-items:center;" :
              "padding:6px 10px;border-radius:var(--radius-sm);font-size:13px;font-weight:700;background:transparent;color:var(--color-text-tertiary);border:none;cursor:pointer;display:inline-flex;align-items:center;",
            title: "카드 보기" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/>
            </svg>
          <% end %>
          <%= link_to favorites_path(request.query_parameters.merge(view_mode: "list")),
            data: { turbo: false },
            style: current_view_mode == "list" ?
              "padding:6px 10px;border-radius:var(--radius-sm);font-size:13px;font-weight:700;background:var(--color-accent);color:#fff;border:none;cursor:pointer;display:inline-flex;align-items:center;" :
              "padding:6px 10px;border-radius:var(--radius-sm);font-size:13px;font-weight:700;background:transparent;color:var(--color-text-tertiary);border:none;cursor:pointer;display:inline-flex;align-items:center;",
            title: "리스트 보기" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          <% end %>
        </div>
      </div>
    </div>

    <div id="url-error"></div>

    <div class="mt-3 flex items-center justify-between gap-3 flex-wrap" style="border-top:1px solid var(--color-border);padding-top:12px;">
      <div class="flex items-center gap-2 flex-wrap">
        <%
          type_options = [["전체", nil], ["웹", "webpage"], ["YouTube", "youtube"], ["GitHub", "github"]]
          type_options.each do |label, value|
            is_active = value.nil? ? params[:content_type].blank? : params[:content_type] == value
        %>
          <%= link_to label,
                favorites_path(q: params[:q], content_type: value, status: params[:status], sort: params[:sort], category: params[:category], view_mode: current_view_mode),
                data: { turbo_frame: "favorites", turbo_action: "replace" },
                style: is_active ?
                  "background:var(--color-accent);color:#fff;padding:6px 11px;border-radius:var(--radius-md);font-size:var(--text-xs);font-weight:700;text-decoration:none;" :
                  "background:var(--color-surface);border:1px solid var(--color-border);color:var(--color-text-tertiary);padding:6px 11px;border-radius:var(--radius-md);font-size:var(--text-xs);font-weight:700;text-decoration:none;" %>
        <% end %>

        <%
          status_options = [["전체 상태", nil], ["완료", "done"], ["분석중", "analyzing"], ["실패", "failed"]]
          status_options.each do |label, value|
            is_active = value.nil? ? params[:status].blank? : params[:status] == value
        %>
          <%= link_to label,
                favorites_path(q: params[:q], content_type: params[:content_type], status: value, sort: params[:sort], category: params[:category], view_mode: current_view_mode),
                data: { turbo_frame: "favorites", turbo_action: "replace" },
                style: is_active ?
                  "background:var(--color-ai-muted);border:1px solid var(--color-ai-accent);color:var(--color-text);padding:6px 11px;border-radius:var(--radius-md);font-size:var(--text-xs);font-weight:700;text-decoration:none;" :
                  "background:var(--color-surface);border:1px solid var(--color-border);color:var(--color-text-tertiary);padding:6px 11px;border-radius:var(--radius-md);font-size:var(--text-xs);font-weight:700;text-decoration:none;" %>
        <% end %>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <% Favorite::CATEGORIES.each do |label| %>
          <% is_active = params[:category] == label || (label == "전체" && params[:category].blank?) %>
          <%= link_to label,
                favorites_path(q: params[:q], content_type: params[:content_type], status: params[:status], sort: params[:sort], category: label == "전체" ? nil : label, view_mode: current_view_mode),
                data: { turbo_frame: "favorites", turbo_action: "replace" },
                style: is_active ?
                  "color:var(--color-accent-text);font-size:var(--text-xs);font-weight:700;text-decoration:none;" :
                  "color:var(--color-text-tertiary);font-size:var(--text-xs);font-weight:650;text-decoration:none;" %>
        <% end %>
      </div>
    </div>
  </section>

  <div class="urlf-workspace-body">
    <section>
      <%= turbo_frame_tag "favorites" do %>
        <% has_favorites = @favorites.respond_to?(:empty?) ? !@favorites.empty? : @favorites.present? %>
        <% if current_view_mode == "card" %>
          <div class="urlf-card-grid" id="favorites-grid">
            <%= render partial: "favorite_card", collection: @favorites, as: :favorite %>
          </div>
        <% else %>
          <div class="hidden" id="favorites-grid"></div>
        <% end %>
        <div id="empty-state" class="<%= 'hidden' if has_favorites %>">
          <%= render "empty_state" %>
        </div>

        <% if current_view_mode == "list" %>
          <div class="rounded-md overflow-hidden" style="border:1px solid var(--color-border);box-shadow:var(--shadow-sm);">
            <table class="w-full" style="background:var(--color-surface);">
              <thead>
                <tr style="border-bottom:1px solid var(--color-border);background:var(--color-surface-raised);">
                  <th class="py-3 px-4 text-left" style="font-size:var(--text-xs);font-weight:700;color:var(--color-text-tertiary);letter-spacing:0;">북마크</th>
                  <th class="py-3 px-4 text-left hidden md:table-cell" style="font-size:var(--text-xs);font-weight:700;color:var(--color-text-tertiary);letter-spacing:0;">유형</th>
                  <th class="py-3 px-4 text-left hidden lg:table-cell" style="font-size:var(--text-xs);font-weight:700;color:var(--color-text-tertiary);letter-spacing:0;">카테고리</th>
                  <th class="py-3 px-4 text-left" style="font-size:var(--text-xs);font-weight:700;color:var(--color-text-tertiary);letter-spacing:0;">상태</th>
                  <th class="py-3 px-4 text-left hidden lg:table-cell" style="font-size:var(--text-xs);font-weight:700;color:var(--color-text-tertiary);letter-spacing:0;">태그</th>
                  <th class="py-3 px-4 text-left hidden sm:table-cell" style="font-size:var(--text-xs);font-weight:700;color:var(--color-text-tertiary);letter-spacing:0;">날짜</th>
                  <th class="py-3 px-4" style="width:80px;"></th>
                </tr>
              </thead>
              <tbody>
                <%= render partial: "favorite_row", collection: @favorites, as: :favorite %>
              </tbody>
            </table>
          </div>
        <% end %>
      <% end %>
    </section>

    <aside class="urlf-desktop-rail">
      <div class="sticky rounded-lg p-4" style="top:92px;background:var(--color-command-bg);border:1px solid var(--color-border);box-shadow:var(--shadow-md);backdrop-filter:blur(18px);">
        <div class="flex items-center justify-between" style="font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);font-weight:700;color:var(--color-text-tertiary);text-transform:uppercase;">
          <span>Analysis Rail</span>
          <span style="color:var(--color-ai-accent);"><%= done_count %>/<%= total_count %></span>
        </div>

        <div class="mt-4 grid grid-cols-3 gap-2">
          <div class="rounded-md p-3" style="background:var(--color-surface);border:1px solid var(--color-border);">
            <div style="font-size:22px;font-weight:750;color:var(--color-text);line-height:1;"><%= done_count %></div>
            <div style="font-size:var(--text-xs);font-weight:650;color:var(--color-text-tertiary);margin-top:5px;">완료</div>
          </div>
          <div class="rounded-md p-3" style="background:var(--color-surface);border:1px solid var(--color-border);">
            <div style="font-size:22px;font-weight:750;color:var(--color-text);line-height:1;"><%= analyzing_count %></div>
            <div style="font-size:var(--text-xs);font-weight:650;color:var(--color-text-tertiary);margin-top:5px;">분석중</div>
          </div>
          <div class="rounded-md p-3" style="background:var(--color-surface);border:1px solid var(--color-border);">
            <div style="font-size:22px;font-weight:750;color:var(--color-text);line-height:1;"><%= failed_count %></div>
            <div style="font-size:var(--text-xs);font-weight:650;color:var(--color-text-tertiary);margin-top:5px;">실패</div>
          </div>
        </div>

        <div class="mt-4 rounded-md p-4" style="background:var(--color-surface);border:1px solid var(--color-border);">
          <div class="flex items-center justify-between gap-3">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);font-weight:700;color:var(--color-ai-accent);text-transform:uppercase;">Same Type Context</div>
            <% if rail_content_type.present? %>
              <span style="font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:700;color:var(--color-text-tertiary);text-transform:uppercase;">
                <%= rail_content_type == "youtube" ? "YouTube" : rail_content_type %>
              </span>
            <% end %>
          </div>

          <% if rail_context_favorites.any? %>
            <div class="mt-3 space-y-3">
              <% rail_context_favorites.each do |favorite| %>
                <article class="rounded-md p-3" data-rail-context-kind="<%= favorite.content_type %>" style="background:var(--color-command-bg);border:1px solid var(--color-border);">
                  <div class="flex items-center gap-2" style="font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:700;color:var(--color-text-tertiary);text-transform:uppercase;">
                    <span><%= favorite.content_type == "youtube" ? "YouTube" : favorite.content_type %></span>
                    <span style="width:3px;height:3px;border-radius:var(--radius-full);background:var(--color-border-strong);"></span>
                    <span><%= favorite.status %></span>
                  </div>
                  <h2 class="mt-2 line-clamp-2" style="font-size:var(--text-sm);line-height:1.35;font-weight:750;color:var(--color-text);letter-spacing:0;">
                    <%= favorite.title.presence || "제목 없음" %>
                  </h2>
                  <p class="mt-2 line-clamp-3" style="font-size:var(--text-xs);line-height:1.55;color:var(--color-text-secondary);">
                    <%= favorite.analysis.summary.presence || "분석 요약이 없습니다." %>
                  </p>
                  <%= link_to "분석 보기",
                        favorite_path(favorite),
                        data: { turbo_frame: "favorites" },
                        style: "display:inline-flex;margin-top:10px;align-items:center;justify-content:center;height:30px;padding:0 10px;border-radius:var(--radius-md);background:var(--color-accent);color:#fff;font-size:var(--text-xs);font-weight:700;text-decoration:none;" %>
                </article>
              <% end %>
            </div>
          <% else %>
            <p class="mt-3" style="font-size:var(--text-sm);line-height:1.55;color:var(--color-text-secondary);">
              같은 종류의 분석 완료 항목이 생기면 이곳에 목록으로 표시됩니다.
            </p>
          <% end %>
        </div>

        <div class="mt-4 rounded-md p-4" style="background:var(--color-ai-muted);border:1px solid var(--color-border);">
          <div style="font-size:var(--text-xs);font-weight:700;color:var(--color-text);">추천 작업 흐름</div>
          <ul class="mt-3 space-y-2" style="font-size:var(--text-sm);line-height:1.45;color:var(--color-text-secondary);">
            <li>유튜브 필터로 실행 가능한 프롬프트만 검토</li>
            <li>실패 항목은 캐시된 raw content로 재시도</li>
            <li>분석 완료 항목을 컬렉션으로 정리</li>
          </ul>
        </div>
      </div>
    </aside>
  </div>
</div>
