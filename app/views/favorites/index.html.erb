<%= turbo_stream_from :favorites %>
<div class="max-w-6xl mx-auto px-6 py-8">

  <%# ── 헤더: Editorial 계층 ── %>
  <div class="mb-8">
    <h1 style="
      font-size:var(--text-3xl);
      font-weight:800;
      letter-spacing:-1.2px;
      color:var(--color-text);
      line-height:1;
      margin-bottom:6px;
    ">Bookmarks</h1>
    <p style="font-size:var(--text-sm);font-weight:500;color:var(--color-text-tertiary);">
      <span id="bookmark-count"><%= @favorites.count %></span>개의 URL이 보관됨
    </p>
  </div>

  <%# ── URL 추가 폼 ── %>
  <div id="url-form" class="mb-8 p-4 rounded-lg" style="background:var(--color-surface);border:1px solid var(--color-border);">
    <%= form_with url: favorites_path, method: :post, class: "flex gap-3" do |f| %>
      <%= f.text_field :url, name: "favorite[url]",
        placeholder: "분석할 URL을 붙여넣으세요...",
        style: "
          flex:1;
          background:var(--color-bg);
          border:1px solid var(--color-border);
          border-radius:var(--radius-md);
          padding:10px 14px;
          font-size:var(--text-sm);
          font-weight:500;
          color:var(--color-text);
          outline:none;
          transition:border-color 0.2s;
        " %>
      <%= f.submit "추가하기",
        style: "
          background:var(--color-accent);
          color:#fff;
          padding:10px 20px;
          border-radius:var(--radius-md);
          font-size:var(--text-sm);
          font-weight:600;
          cursor:pointer;
          border:none;
          transition:background 0.2s, transform 0.15s;
        ",
        onmouseover: "this.style.background='var(--color-accent-hover)'",
        onmouseout: "this.style.background='var(--color-accent)'" %>
    <% end %>
  </div>

  <%# ── 검색바 ── %>
  <%= render "search_bar" %>

  <%# ── 필터 + 정렬 + 뷰모드 툴바 ── %>
  <div class="flex items-center justify-between gap-4 mb-6 pb-4 flex-wrap"
       style="border-bottom:1px solid var(--color-border);">

    <%# 좌측: 필터 pill 그룹 %>
    <div class="flex items-center gap-3 flex-wrap">
      <%# 유형 필터 %>
      <div class="flex items-center gap-1.5 p-1 rounded-lg" style="background:var(--color-surface);border:1px solid var(--color-border);">
        <%
          type_options = [["전체", nil], ["웹", "webpage"], ["YouTube", "youtube"], ["GitHub", "github"]]
          type_options.each do |label, value|
            is_active = value.nil? ? params[:content_type].blank? : params[:content_type] == value
        %>
          <%= link_to label,
                favorites_path(q: params[:q], content_type: value, status: params[:status], sort: params[:sort], category: params[:category]),
                data: { turbo_frame: "favorites", turbo_action: "replace" },
                style: is_active ?
                  "background:var(--color-accent);color:#fff;padding:4px 12px;border-radius:var(--radius-md);font-size:var(--text-xs);font-weight:600;transition:all 0.2s;" :
                  "color:var(--color-text-tertiary);padding:4px 12px;border-radius:var(--radius-md);font-size:var(--text-xs);font-weight:500;transition:all 0.2s;" %>
        <% end %>
      </div>

      <%# 카테고리 필터 %>
      <div class="flex items-center gap-1.5 p-1 rounded-lg" style="background:var(--color-surface);border:1px solid var(--color-border);">
        <%
          category_options = Favorite::CATEGORIES
          category_options.each do |label|
            is_active = params[:category] == label || (label == "전체" && params[:category].blank?)
        %>
          <%= link_to label,
                favorites_path(q: params[:q], content_type: params[:content_type], status: params[:status], sort: params[:sort], category: label == "전체" ? nil : label),
                data: { turbo_frame: "favorites", turbo_action: "replace" },
                style: is_active ?
                  "background:var(--color-accent);color:#fff;padding:4px 10px;border-radius:var(--radius-md);font-size:var(--text-xs);font-weight:600;transition:all 0.2s;" :
                  "color:var(--color-text-tertiary);padding:4px 10px;border-radius:var(--radius-md);font-size:var(--text-xs);font-weight:500;transition:all 0.2s;" %>
        <% end %>
      </div>

      <%# 상태 필터 %>
      <div class="flex items-center gap-1.5 p-1 rounded-lg" style="background:var(--color-surface);border:1px solid var(--color-border);">
        <%
          status_options = [["전체", nil], ["대기", "pending"], ["분석중", "analyzing"], ["완료", "done"], ["실패", "failed"]]
          status_options.each do |label, value|
            is_active = value.nil? ? params[:status].blank? : params[:status] == value
        %>
          <%= link_to label,
                favorites_path(q: params[:q], content_type: params[:content_type], status: value, sort: params[:sort], category: params[:category]),
                data: { turbo_frame: "favorites", turbo_action: "replace" },
                style: is_active ?
                  "background:var(--color-accent);color:#fff;padding:4px 12px;border-radius:var(--radius-md);font-size:var(--text-xs);font-weight:600;transition:all 0.2s;" :
                  "color:var(--color-text-tertiary);padding:4px 12px;border-radius:var(--radius-md);font-size:var(--text-xs);font-weight:500;transition:all 0.2s;" %>
        <% end %>
      </div>
    </div>

    <%# 우측: 정렬 + 뷰모드 %>
    <div class="flex items-center gap-3">
      <%# 정렬 %>
      <div class="flex items-center gap-2">
        <%= form_with url: favorites_path, method: :get, class: "flex", data: { turbo_frame: "favorites", turbo_action: "replace" } do %>
          <input type="hidden" name="q" value="<%= params[:q] %>">
          <input type="hidden" name="content_type" value="<%= params[:content_type] %>">
          <input type="hidden" name="status" value="<%= params[:status] %>">
          <input type="hidden" name="category" value="<%= params[:category] %>">
          <select name="sort"
            onchange="this.form.requestSubmit()"
            style="
              background:var(--color-surface);
              border:1px solid var(--color-border);
              border-radius:var(--radius-md);
              padding:6px 10px;
              font-size:var(--text-xs);
              font-weight:500;
              color:var(--color-text-secondary);
              outline:none;
              cursor:pointer;
            ">
            <option value="recent" <%= "selected" if params[:sort] == "recent" || params[:sort].blank? %>>최근 추가</option>
            <option value="oldest" <%= "selected" if params[:sort] == "oldest" %>>오래된 순</option>
            <option value="title" <%= "selected" if params[:sort] == "title" %>>제목 순</option>
          </select>
        <% end %>
      </div>

      <%# 뷰모드 토글 %>
      <div class="flex items-center gap-0.5 p-1 rounded-lg" style="background:var(--color-surface);border:1px solid var(--color-border);" data-controller="view-mode">
        <button type="button"
          style="
            padding:5px 10px;
            border-radius:var(--radius-sm);
            font-size:var(--text-xs);
            font-weight:600;
            transition:all 0.2s;
            background:var(--color-accent);
            color:#fff;
            border:none;
            cursor:pointer;
          "
          data-view-mode-target="cardButton"
          data-action="view-mode#switchToCard">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/>
          </svg>
        </button>
        <button type="button"
          style="
            padding:5px 10px;
            border-radius:var(--radius-sm);
            font-size:var(--text-xs);
            font-weight:600;
            transition:all 0.2s;
            background:transparent;
            color:var(--color-text-tertiary);
            border:none;
            cursor:pointer;
          "
          data-view-mode-target="listButton"
          data-action="view-mode#switchToList">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <%# ── 북마크 그리드 ── %>
  <%= turbo_frame_tag "favorites" do %>
    <% has_favorites = @favorites.respond_to?(:empty?) ? !@favorites.empty? : @favorites.present? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="favorites-grid" data-view-mode-target="cardView">
      <%= render partial: "favorite_card", collection: @favorites, as: :favorite %>
    </div>
    <div id="empty-state" class="<%= 'hidden' if has_favorites %>">
      <%= render "empty_state" %>
    </div>
    <%# 리스트 뷰 %>
    <div class="hidden rounded-lg overflow-hidden" style="border:1px solid var(--color-border);" data-view-mode-target="listView">
      <table class="w-full" style="background:var(--color-surface);">
        <thead>
          <tr style="border-bottom:1px solid var(--color-border);">
            <th class="py-3 px-4 text-left" style="font-size:var(--text-xs);font-weight:600;color:var(--color-text-tertiary);letter-spacing:0.3px;">북마크</th>
            <th class="py-3 px-4 text-left hidden md:table-cell" style="font-size:var(--text-xs);font-weight:600;color:var(--color-text-tertiary);letter-spacing:0.3px;">유형</th>
            <th class="py-3 px-4 text-left" style="font-size:var(--text-xs);font-weight:600;color:var(--color-text-tertiary);letter-spacing:0.3px;">상태</th>
            <th class="py-3 px-4 text-left hidden lg:table-cell" style="font-size:var(--text-xs);font-weight:600;color:var(--color-text-tertiary);letter-spacing:0.3px;">태그</th>
            <th class="py-3 px-4 text-left hidden sm:table-cell" style="font-size:var(--text-xs);font-weight:600;color:var(--color-text-tertiary);letter-spacing:0.3px;">날짜</th>
            <th class="py-3 px-4" style="width:80px;"></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "favorite_row", collection: @favorites, as: :favorite %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
