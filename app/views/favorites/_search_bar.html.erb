<%= form_with url: favorites_path, method: :get, class: "mb-4", data: { turbo_frame: "favorites" } do %>
  <input
    type="text"
    name="q"
    value="<%= params[:q] %>"
    placeholder="즐겨찾기 검색..."
    data-controller="auto-submit"
    data-action="input->auto-submit#submit"
    style="width:100%;border:1px solid var(--color-border);border-radius:var(--radius-sm);padding:8px 12px;font-size:15px;font-weight:500;color:var(--color-text);background:var(--color-surface);outline:none;transition:border-color 0.15s;"
    class="focus:ring-2 focus:ring-offset-1"
  >
<% end %>
