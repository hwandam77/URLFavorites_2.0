<%= turbo_frame_tag "favorites" do %>
<style>
  .brief { max-width: 680px; margin: 0 auto; padding: 40px 24px 80px; }
  .mono { font-family: ui-monospace, 'SF Mono', 'IBM Plex Mono', Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }
  .brief a { color: var(--color-accent-text); }
  .brief a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; border-radius: 2px; }

  .masthead { border-bottom: 2px solid var(--color-text); padding-bottom: 10px; display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .wordmark { font-size: 15px; font-weight: 800; letter-spacing: 2.5px; color: var(--color-text); text-transform: uppercase; }
  .wordmark em { font-style: normal; color: var(--color-accent-text); }
  .issue { font-size: 12px; letter-spacing: 0.5px; color: var(--color-text-tertiary); }
  .runningmeta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 10px 0 0; font-size: 12px; letter-spacing: 0.6px; text-transform: uppercase; color: var(--color-text-tertiary); font-weight: 600; }
  .runningmeta .sep { color: var(--color-border-strong); }
  .chip { display: inline-flex; align-items: center; gap: 5px; padding: 2px 9px; border-radius: var(--radius-full); font-size: 11px; font-weight: 700; letter-spacing: 0.4px; border: 1px solid; }
  .chip-tier { background: var(--color-ai-muted); color: var(--color-text); border-color: var(--color-ai-accent); }
  .chip-done { background: var(--color-done-bg); color: var(--color-done-text); border-color: var(--color-done-border); }

  .headline { margin: 28px 0 0; font-size: 34px; line-height: 1.22; font-weight: 800; letter-spacing: -1.1px; text-wrap: balance; color: var(--color-text); }
  .source { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 14px; font-size: 13px; color: var(--color-text-tertiary); }
  .source .dot { width: 14px; height: 14px; border-radius: 3px; background: var(--color-accent-muted); border: 1px solid var(--color-border); flex-shrink: 0; }
  .source a { font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--color-accent-muted); padding-bottom: 1px; }
  .source a:hover { border-bottom-color: var(--color-accent); }

  .repo-card { margin: 24px 0 0; padding: 18px 20px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .repo-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .repo-name { font-size: 15px; font-weight: 700; color: var(--color-text); }
  .repo-flag { font-size: 11px; font-weight: 700; padding: 1px 7px; border-radius: var(--radius-full); background: var(--color-pending-bg); color: var(--color-pending-text); border: 1px solid var(--color-pending-border); }
  .repo-desc { margin: 8px 0 0; font-size: 14px; line-height: 1.6; color: var(--color-text-secondary); }
  .repo-stats { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 14px 0 0; }
  .repo-stats > div { display: flex; align-items: baseline; gap: 6px; }
  .repo-stats dt { font-size: 10.5px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; color: var(--color-text-tertiary); }
  .repo-stats dd { margin: 0; font-size: 14px; font-weight: 650; color: var(--color-text); }
  .repo-topics { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 0; }
  .repo-topics span { font-size: 11.5px; font-weight: 600; padding: 2px 9px; border-radius: var(--radius-full); background: var(--color-accent-muted); color: var(--color-accent-text); }

  .lead { margin: 30px 0 0; padding-left: 20px; border-left: 2px solid var(--color-accent); font-size: 19px; line-height: 1.62; font-weight: 500; color: var(--color-text); letter-spacing: -0.2px; }

  .contents { margin: 40px 0 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 20px 0; }
  .contents-label { font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--color-text-tertiary); margin-bottom: 14px; }
  .toc { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .toc li { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px; align-items: baseline; }
  .toc .n { font-size: 11px; font-weight: 700; color: var(--color-accent-text); }
  .toc a { font-size: 15px; font-weight: 600; color: var(--color-text); text-decoration: none; border-bottom: 1px solid transparent; }
  .toc a:hover { border-bottom-color: var(--color-accent); }
  .toc .dek { display: block; font-size: 13px; font-weight: 400; color: var(--color-text-tertiary); line-height: 1.5; margin-top: 1px; }
  .toc .pending { font-size: 11px; font-weight: 700; color: var(--color-analyzing-text); margin-left: 6px; }
  .stats { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 18px; padding-top: 14px; border-top: 1px dashed var(--color-border); font-size: 12px; color: var(--color-text-tertiary); letter-spacing: 0.3px; }
  .stats b { color: var(--color-text-secondary); font-weight: 700; }

  .section { margin-top: 44px; scroll-margin-top: 24px; }
  .section-head { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 0 14px; align-items: start; }
  .section-n { font-size: 26px; font-weight: 700; line-height: 1.05; color: var(--color-border-strong); letter-spacing: -0.5px; padding-top: 2px; }
  .section h2 { margin: 0; font-size: 23px; font-weight: 750; letter-spacing: -0.5px; line-height: 1.3; color: var(--color-text); text-wrap: balance; }
  .section .dek { grid-column: 2; margin: 6px 0 0; font-size: 14px; line-height: 1.55; color: var(--color-accent-text); font-weight: 500; }
  .section-body { grid-column: 2; margin-top: 16px; color: var(--color-text-secondary); line-height: 1.8; font-size: 16px; }
  .section-body p { margin: 0 0 1em; }
  .section-body ul, .section-body ol { margin: 0 0 1em; padding-left: 1.4em; }
  .section-body li { margin-bottom: 0.35em; }
  .section-body strong { color: var(--color-text); font-weight: 700; }
  .section-body code { font-family: ui-monospace, 'SF Mono', 'IBM Plex Mono', Menlo, monospace; font-size: 14px; background: var(--color-surface-raised); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 1px 5px; }
  .section-body pre { overflow-x: auto; margin: 0 0 1em; padding: 14px 16px; background: var(--color-surface-raised); border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: 13.5px; line-height: 1.6; }
  .section-body pre code { background: none; border: none; padding: 0; }
  .section-body table { display: block; overflow-x: auto; border-collapse: collapse; margin: 0 0 1em; font-size: 14px; }
  .section-body th, .section-body td { border: 1px solid var(--color-border); padding: 7px 12px; text-align: left; white-space: nowrap; }
  .section-body th { background: var(--color-surface-raised); color: var(--color-text); font-weight: 650; }
  .section-body h1, .section-body h2, .section-body h3, .section-body h4 { color: var(--color-text); font-weight: 700; margin: 1.4em 0 0.6em; letter-spacing: -0.3px; }
  .section-body h1 { font-size: 20px; }
  .section-body h2 { font-size: 18px; }
  .section-body h3, .section-body h4 { font-size: 16px; }
  .section-body em { font-style: italic; }
  .section-body a { color: var(--color-accent-text); text-decoration: underline; }
  .section-body hr { border: none; border-top: 1px solid var(--color-border); margin: 1.5em 0; }
  .section-body blockquote { margin: 0 0 1em; padding: 12px 16px; border-left: 3px solid var(--color-accent); background: var(--color-accent-muted); border-radius: 0 var(--radius-md) var(--radius-md) 0; }
  .section-body blockquote p:last-child { margin-bottom: 0; }
  @media (max-width: 560px) { .section-head { grid-template-columns: minmax(0, 1fr); } .section-n { font-size: 13px; font-weight: 800; color: var(--color-accent-text); padding: 0 0 4px; } .section .dek, .section-body, .generating { grid-column: 1; } }

  .contents.no-toc .stats { margin-top: 0; padding-top: 0; border-top: none; }

  .longform h2 { margin: 0 0 16px; font-size: 23px; font-weight: 750; letter-spacing: -0.5px; line-height: 1.3; color: var(--color-text); }
  .longform .section-body { grid-column: auto; margin-top: 0; }

  .lede-figure { margin: 28px 0 0; }
  .lede-figure img { display: block; width: 100%; aspect-ratio: 16/9; object-fit: cover; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .lede-figure figcaption { margin-top: 8px; font-size: 12px; color: var(--color-text-tertiary); text-align: center; }

  .timeline { margin-top: 48px; }
  .timeline h2 { margin: 0 0 16px; font-size: 20px; font-weight: 750; letter-spacing: -0.4px; color: var(--color-text); }
  .timeline-box { max-height: 360px; overflow-y: auto; background: var(--color-surface-raised); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .timeline-row { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--color-border); }
  .timeline-row:last-child { border-bottom: none; }
  .timeline-row .ts { font-size: 12px; font-weight: 800; color: var(--color-accent-text); text-decoration: none; }
  .timeline-row p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--color-text-secondary); }
  .timeline-more { margin: 8px 0 0; font-size: 12px; color: var(--color-text-tertiary); }

  .generating { grid-column: 2; display: flex; align-items: center; gap: 9px; margin-top: 16px; padding: 13px 16px; border-radius: var(--radius-md); background: var(--color-analyzing-bg); border: 1px solid var(--color-analyzing-border); color: var(--color-analyzing-text); font-size: 14px; font-weight: 600; }
  .spinner { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--color-analyzing-border); border-top-color: var(--color-analyzing-text); animation: spin 0.8s linear infinite; flex-shrink: 0; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .spinner { animation-duration: 3s; } }

  .marked { margin-top: 52px; padding-top: 26px; border-top: 2px solid var(--color-text); }
  .marked h2 { margin: 0 0 4px; font-size: 20px; font-weight: 750; letter-spacing: -0.4px; color: var(--color-text); }
  .marked-sub { margin: 0 0 22px; font-size: 13px; color: var(--color-text-tertiary); }
  .points { display: grid; gap: 20px; }
  .point { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 12px; }
  .point-n { font-size: 13px; font-weight: 700; color: var(--color-accent); padding-top: 4px; }
  .point-cat { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; color: var(--color-accent-text); margin-bottom: 3px; }
  .point p { margin: 0; font-size: 16.5px; line-height: 1.65; color: var(--color-text); }
  .point .evidence { display: inline-block; margin-top: 6px; font-size: 12px; font-weight: 700; text-decoration: none; color: var(--color-accent-text); border-bottom: 1px solid var(--color-ai-accent); }

  .editor { margin-top: 48px; padding: 22px 24px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .editor-label { font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--color-text-tertiary); margin: 0 0 10px; }
  .editor p { margin: 0; font-size: 16px; line-height: 1.72; color: var(--color-text-secondary); white-space: pre-wrap; }
  .editor strong { color: var(--color-text); }

  .colophon { margin-top: 48px; padding-top: 22px; border-top: 1px solid var(--color-border); }
  .keywords { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-bottom: 20px; }
  .keywords span { font-size: 14px; font-weight: 600; color: var(--color-accent-text); }
  .colophon-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 14px 20px; font-size: 12px; }
  .colophon-grid dt { color: var(--color-text-tertiary); letter-spacing: 0.5px; text-transform: uppercase; font-size: 10.5px; font-weight: 700; margin-bottom: 3px; }
  .colophon-grid dd { margin: 0; color: var(--color-text-secondary); font-weight: 600; }

  .related { margin-top: 44px; }
  .related h2 { margin: 0 0 16px; font-size: 18px; font-weight: 750; letter-spacing: -0.3px; color: var(--color-text); }
  .related ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .related a { display: flex; align-items: center; gap: 12px; padding: 13px 15px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); text-decoration: none; transition: border-color 0.18s; }
  .related a:hover { border-color: var(--color-accent); }
  .related .kind { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: var(--radius-full); background: var(--color-accent-muted); color: var(--color-accent-text); flex-shrink: 0; }
  .related .t { font-size: 14px; font-weight: 550; color: var(--color-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .memo { margin-top: 44px; }
  .memo h2 { margin: 0 0 14px; font-size: 18px; font-weight: 750; letter-spacing: -0.3px; color: var(--color-text); }
  .memo-box { padding: 18px 20px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-text-secondary); font-size: 15.5px; line-height: 1.7; white-space: pre-wrap; }

  .footrule { margin-top: 56px; padding-top: 18px; border-top: 2px solid var(--color-text); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 11.5px; letter-spacing: 0.6px; text-transform: uppercase; color: var(--color-text-tertiary); font-weight: 600; }
</style>

<div class="brief">

  <%= link_to favorite_path(@favorite),
        class: "inline-flex items-center gap-1.5 mb-6 transition-colors",
        style: "color:var(--color-text-tertiary);font-size:13px;font-weight:500;text-decoration:none;",
        onmouseover: "this.style.color='var(--color-accent)'",
        onmouseout: "this.style.color='var(--color-text-tertiary)'" do %>
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
    </svg>
    상세페이지로 돌아가기
  <% end %>

  <header class="masthead">
    <div class="wordmark">URLF <em>BRIEF</em></div>
    <div class="issue mono">NO. <%= @favorite.id.to_s.rjust(4, "0") %> · <%= @favorite.created_at.strftime("%Y.%m.%d") %></div>
  </header>
  <div class="runningmeta mono">
    <span><%= @favorite.content_type == "youtube" ? "YouTube" : "웹페이지" %></span>
    <span class="sep">/</span>
    <span><%= @analysis.analysis_style_label %></span>
    <% if @favorite.status == "done" %><span class="sep">/</span><span class="chip chip-done">분석 완료</span><% end %>
    <% if @analysis.analysis_tier == "heavy" %><span class="chip chip-tier">정밀 · heavy</span><% end %>
  </div>

  <h1 class="headline"><%= @favorite.title.presence || @favorite.url %></h1>
  <div class="source">
    <% if @favorite.favicon_url.present? %>
      <img class="dot" src="<%= @favorite.favicon_url %>" alt="" onerror="this.style.display='none'">
    <% else %>
      <span class="dot" aria-hidden="true"></span>
    <% end %>
    <span><%= URI.parse(@favorite.url).host&.sub(/^www\./, "") rescue nil %></span>
    <span class="sep" aria-hidden="true">·</span>
    <a href="<%= @favorite.url %>" target="_blank" rel="noopener noreferrer">원본 링크 열기 ↗</a>
  </div>

  <% repo = @favorite.content_type == "github" ? @favorite.source_metadata : nil %>
  <% repo = nil unless repo.is_a?(Hash) && repo["full_name"].present? %>
  <% if repo %>
    <section class="repo-card">
      <div class="repo-head">
        <span class="repo-name mono"><%= repo["full_name"] %></span>
        <% if repo["archived"] %><span class="repo-flag">보관됨</span><% end %>
        <% if repo["fork"] %><span class="repo-flag">포크</span><% end %>
      </div>
      <% if repo["description"].present? %>
        <p class="repo-desc"><%= repo["description"] %></p>
      <% end %>
      <% pushed_at = (Time.parse(repo["pushed_at"]).strftime("%Y.%m.%d") rescue nil) %>
      <dl class="repo-stats">
        <% unless repo["stars"].nil? %>
          <div><dt>★</dt><dd class="mono"><%= number_with_delimiter(repo["stars"]) %></dd></div>
        <% end %>
        <% unless repo["forks"].nil? %>
          <div><dt>포크</dt><dd class="mono"><%= number_with_delimiter(repo["forks"]) %></dd></div>
        <% end %>
        <% if repo["language"].present? %>
          <div><dt>언어</dt><dd><%= repo["language"] %></dd></div>
        <% end %>
        <% if repo["license"].present? %>
          <div><dt>라이선스</dt><dd><%= repo["license"] %></dd></div>
        <% end %>
        <% unless repo["open_issues"].nil? %>
          <div><dt>이슈</dt><dd class="mono"><%= number_with_delimiter(repo["open_issues"]) %></dd></div>
        <% end %>
        <% if pushed_at.present? %>
          <div><dt>최근 푸시</dt><dd class="mono"><%= pushed_at %></dd></div>
        <% end %>
      </dl>
      <% if repo["topics"].present? %>
        <div class="repo-topics">
          <% Array(repo["topics"]).first(8).each do |t| %><span><%= t %></span><% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <p class="lead"><%= @analysis.summary %></p>

  <% if @favorite.content_type == "youtube" && @favorite.thumbnail_url.present? %>
    <figure class="lede-figure">
      <img src="<%= @favorite.thumbnail_url %>" alt="" loading="lazy" onerror="this.parentElement.style.display='none'">
      <% if @analysis.subtitle_source.present? %>
        <figcaption>자막 출처: <%= @analysis.subtitle_source %></figcaption>
      <% end %>
    </figure>
  <% end %>

  <% total_chars = @sections.any? ? @sections.sum { |s| s.body.to_s.length } : @analysis.detail_content.to_s.length %>
  <div class="contents<%= " no-toc" if @sections.empty? %>">
    <% if @sections.any? %>
      <p class="contents-label">이 호의 구성</p>
      <nav aria-label="이 호의 구성">
        <ol class="toc">
          <% @sections.each do |section| %>
            <li>
              <span class="n mono"><%= section.position.to_s.rjust(2, "0") %></span>
              <span>
                <a href="#s<%= section.position %>"><%= section.heading %></a>
                <% if section.focus.present? %><span class="dek"><%= section.focus %></span><% end %>
                <% if section.body.blank? %><span class="pending">생성 중…</span><% end %>
              </span>
            </li>
          <% end %>
        </ol>
      </nav>
    <% else %>
      <p class="contents-label">이 브리프</p>
    <% end %>
    <div class="stats mono">
      <% if @sections.any? %>
        <span>섹션 <b><%= @sections.size %></b></span><span>·</span>
      <% end %>
      <span>본문 <b><%= number_with_delimiter(total_chars) %></b>자</span><span>·</span>
      <span>읽는 데 <b>약 <%= [ (total_chars / 500.0).ceil, 1 ].max %>분</b></span>
    </div>
  </div>

  <% if @sections.any? %>
    <% @sections.each do |section| %>
      <section class="section" id="s<%= section.position %>">
        <div class="section-head">
          <div class="section-n mono"><%= section.position.to_s.rjust(2, "0") %></div>
          <h2><%= section.heading %></h2>
          <% if section.focus.present? %><p class="dek"><%= section.focus %></p><% end %>
          <% if section.body.present? %>
            <div class="section-body"><%= markdown(section.body) %></div>
          <% else %>
            <div class="generating"><span class="spinner" aria-hidden="true"></span><span>이 섹션은 아직 생성 중…</span></div>
          <% end %>
        </div>
      </section>
    <% end %>
  <% elsif @analysis.detail_content.present? %>
    <section class="section longform">
      <h2><%= @analysis.analysis_style_label %></h2>
      <div class="section-body"><%= markdown(@analysis.detail_content) %></div>
    </section>
  <% end %>

  <% segments = @favorite.content_type == "youtube" ? @analysis.parsed_transcript_segments : [] %>
  <% if segments.any? %>
    <section class="timeline">
      <h2>타임라인 자막</h2>
      <div class="timeline-box">
        <% segments.first(80).each do |seg| %>
          <% seg_url = youtube_timestamp_url(@favorite.url, seg["timestamp"]) %>
          <div class="timeline-row">
            <% if seg_url.present? %>
              <a class="ts mono" href="<%= seg_url %>" target="_blank" rel="noopener noreferrer"><%= seg["timestamp"] %></a>
            <% else %>
              <span class="ts mono"><%= seg["timestamp"] %></span>
            <% end %>
            <p><%= seg["text"] %></p>
          </div>
        <% end %>
      </div>
      <% if segments.size > 80 %>
        <p class="timeline-more">외 <%= segments.size - 80 %>개 구간</p>
      <% end %>
    </section>
  <% end %>

  <section class="marked">
    <h2>밑줄 그은 문장</h2>
    <p class="marked-sub">원문에서 뽑은 핵심 주장과 그 근거 위치</p>
    <div class="points">
      <% @analysis.parsed_key_points.each_with_index do |kp, i| %>
        <div class="point">
          <div class="point-n mono"><%= (i + 1).to_s.rjust(2, "0") %></div>
          <div>
            <% if kp["category"].present? %><span class="point-cat"><%= kp["category"] %></span><% end %>
            <p><%= kp["point"] %></p>
            <% if kp["timestamp"].present? %>
              <% if @favorite.content_type == "youtube" %>
                <a class="evidence" href="<%= youtube_timestamp_url(@favorite.url, kp["timestamp"]) %>" target="_blank" rel="noopener noreferrer">근거 · <%= kp["timestamp"] %></a>
              <% else %>
                <span class="evidence">근거 · <%= kp["timestamp"] %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <% if @sections.any? && @analysis.detail_content.present? %>
    <aside class="editor">
      <p class="editor-label">편집자 노트</p>
      <p><%= @analysis.detail_content %></p>
    </aside>
  <% end %>

  <footer class="colophon">
    <div class="keywords">
      <% @analysis.parsed_tags.each do |tag| %><span>#<%= tag %></span><% end %>
    </div>
    <dl class="colophon-grid">
      <div><dt>분석 모델</dt><dd class="mono"><%= @analysis.model_used %></dd></div>
      <div><dt>분석 티어</dt><dd><%= @analysis.analysis_tier == "heavy" ? "정밀" : "빠름" %></dd></div>
      <div><dt>분석 스타일</dt><dd><%= @analysis.analysis_style_label %></dd></div>
      <% if @analysis.sentiment.present? %>
        <div><dt>감정</dt><dd><%= @analysis.sentiment %></dd></div>
      <% end %>
      <div><dt>저장일</dt><dd class="mono"><%= @favorite.created_at.strftime("%Y.%m.%d") %></dd></div>
      <div><dt>최종 생성</dt><dd class="mono"><%= @analysis.updated_at.strftime("%Y.%m.%d %H:%M") %></dd></div>
    </dl>
  </footer>

  <% collection_ids = @favorite.collections.ids %>
  <% related = collection_ids.any? \
       ? Favorite.joins(:collections).where(collections: { id: collection_ids }).where.not(id: @favorite.id).where(status: "done").distinct.order(created_at: :desc).limit(5) \
       : Favorite.none %>
  <% if related.any? %>
    <section class="related">
      <h2>같은 컬렉션에서 함께 읽기</h2>
      <ul>
        <% related.each do |rel| %>
          <li><%= link_to favorite_path(rel) do %><span class="kind"><%= rel.content_type == "youtube" ? "YouTube" : "웹" %></span><span class="t"><%= rel.title&.truncate(60) || rel.url %></span><% end %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @favorite.note.present? %>
    <section class="memo">
      <h2>내 메모</h2>
      <div class="memo-box"><%= @favorite.note %></div>
    </section>
  <% end %>

  <div class="footrule mono">
    <span>URLF BRIEF · NO. <%= @favorite.id.to_s.rjust(4, "0") %></span>
    <%= link_to "아카이브로 돌아가기 →", favorites_path, style: "color:inherit;text-decoration:none;" %>
  </div>

</div>
<% end %>
