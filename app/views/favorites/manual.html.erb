<%= turbo_frame_tag "favorites" do %>
<style>
  .manual-body { color: var(--color-text-secondary); line-height: 1.8; font-size: var(--text-base); }
  .manual-body h1, .manual-body h2, .manual-body h3, .manual-body h4 { color: var(--color-text); font-weight: 700; margin: 1.4em 0 0.6em; letter-spacing: -0.3px; }
  .manual-body h1 { font-size: var(--text-xl); }
  .manual-body h2 { font-size: var(--text-lg); }
  .manual-body h3, .manual-body h4 { font-size: var(--text-base); }
  .manual-body p { margin: 0 0 1em; }
  .manual-body ul, .manual-body ol { margin: 0 0 1em; padding-left: 1.5em; }
  .manual-body li { margin-bottom: 0.3em; }
  .manual-body a { color: var(--color-accent-text); text-decoration: underline; }
  .manual-body strong { color: var(--color-text); }
  .manual-body hr { border: none; border-top: 1px solid var(--color-border); margin: 1.5em 0; }
  .manual-body blockquote { margin: 0 0 1em; padding: 12px 16px; border-left: 3px solid var(--color-accent); background: var(--color-accent-muted); border-radius: 0 var(--radius-md) var(--radius-md) 0; }
  .manual-body blockquote p:last-child { margin-bottom: 0; }
  .manual-body code { font-family: 'IBM Plex Mono', monospace; font-size: var(--text-sm); background: var(--color-surface-raised); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 1px 5px; }
  .manual-body pre { overflow-x: auto; margin: 0 0 1em; padding: 14px 16px; background: var(--color-surface-raised); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .manual-body pre code { background: none; border: none; padding: 0; }
  .manual-body table { display: block; overflow-x: auto; border-collapse: collapse; margin: 0 0 1em; font-size: var(--text-sm); }
  .manual-body th, .manual-body td { border: 1px solid var(--color-border); padding: 6px 12px; text-align: left; }
  .manual-body th { background: var(--color-surface-raised); color: var(--color-text); font-weight: 600; }
</style>

<div class="max-w-3xl mx-auto px-6 py-10" style="--text-xs:13px;--text-sm:15px;--text-base:16px;--text-lg:18px;--text-xl:22px;--text-2xl:32px;">

  <%# ── 문서 헤더 ── %>
  <div class="mb-8">
    <%= link_to favorite_path(@favorite),
          class: "inline-flex items-center gap-1.5 mb-6 transition-colors",
          style: "color:var(--color-text-tertiary);font-size:var(--text-xs);font-weight:500;",
          onmouseover: "this.style.color='var(--color-accent)'",
          onmouseout: "this.style.color='var(--color-text-tertiary)'" do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      상세페이지로 돌아가기
    <% end %>

    <div class="flex items-center gap-2 mb-4" style="font-size:var(--text-xs);font-weight:600;color:var(--color-text-tertiary);text-transform:uppercase;letter-spacing:0.8px;">
      <span>온보딩 매뉴얼</span>
      <span style="color:var(--color-border);">·</span>
      <span><%= @analysis.updated_at.strftime("%Y.%m.%d") %> 생성</span>
    </div>

    <h1 style="font-size:var(--text-2xl);font-weight:800;letter-spacing:-1px;color:var(--color-text);line-height:1.25;margin-bottom:12px;">
      <%= @favorite.title.presence || @favorite.url %>
    </h1>

    <% total_chars = @sections.sum { |s| s.body.to_s.length } %>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1" style="font-size:var(--text-xs);color:var(--color-text-tertiary);">
      <a href="<%= @favorite.url %>" target="_blank" rel="noopener noreferrer"
         style="color:var(--color-accent-text);font-weight:600;text-decoration:none;">
        원문 링크
      </a>
      <span style="color:var(--color-border);">·</span>
      <span>모델: <%= @sections.first.backend_model.presence || "-" %></span>
      <span style="color:var(--color-border);">·</span>
      <span>총 <%= number_with_delimiter(total_chars) %>자</span>
      <span style="color:var(--color-border);">·</span>
      <span>섹션 <%= @sections.size %>개</span>
    </div>
  </div>

  <%# ── 목차 ── %>
  <nav class="mb-10" style="padding:16px 20px;border-radius:var(--radius-md);background:var(--color-surface);border:1px solid var(--color-border);">
    <p style="font-size:var(--text-xs);font-weight:600;color:var(--color-text-tertiary);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:10px;">목차</p>
    <ol style="margin:0;padding-left:1.4em;display:flex;flex-direction:column;gap:6px;">
      <% @sections.each do |section| %>
        <li style="font-size:var(--text-sm);">
          <a href="#section-<%= section.position %>"
             style="color:var(--color-text-secondary);text-decoration:none;font-weight:500;">
            <%= section.heading %>
          </a>
          <% if section.body.nil? %>
            <span style="color:var(--color-analyzing-text);font-size:var(--text-xs);font-weight:600;"> · 생성 중…</span>
          <% end %>
        </li>
      <% end %>
    </ol>
  </nav>

  <%# ── 본문 ── %>
  <% @sections.each do |section| %>
    <section id="section-<%= section.position %>" class="mb-10" style="scroll-margin-top:24px;">
      <h2 style="font-size:var(--text-xl);font-weight:700;color:var(--color-text);margin-bottom:16px;letter-spacing:-0.3px;">
        <%= section.heading %>
      </h2>
      <% if section.body.present? %>
        <div class="manual-body"><%= markdown(section.body) %></div>
      <% else %>
        <div class="flex items-center gap-2" style="color:var(--color-analyzing-text);padding:16px 20px;border-radius:var(--radius-md);background:var(--color-analyzing-bg);border:1px solid var(--color-analyzing-border);">
          <span class="w-3 h-3 rounded-full animate-spin" style="border:2px solid var(--color-analyzing-border);border-top-color:var(--color-analyzing-text);"></span>
          <span style="font-size:var(--text-sm);font-weight:600;">이 섹션은 아직 생성 중…</span>
        </div>
      <% end %>
    </section>
  <% end %>

  <hr style="border:none;border-top:1px solid var(--color-border);margin:32px 0;">
  <%= link_to "상세페이지로 돌아가기", favorite_path(@favorite),
        style: "color:var(--color-accent-text);font-size:var(--text-sm);font-weight:600;text-decoration:none;" %>
</div>
<% end %>
