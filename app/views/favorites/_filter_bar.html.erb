<div class="flex flex-wrap gap-3 items-center mb-6">

  <%# 유형 필터 %>
  <div class="flex items-center gap-2">
    <span style="font-size:10px;font-weight:700;letter-spacing:0.6px;color:var(--color-text-muted);text-transform:uppercase;">유형</span>
    <div class="flex" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:9999px;padding:3px;gap:2px;">
      <%
        type_options = [["전체", nil], ["웹", "webpage"], ["YouTube", "youtube"]]
        type_options.each do |label, value|
          is_active = value.nil? ? params[:content_type].blank? : params[:content_type] == value
          active_style = "background:var(--color-accent);color:#fff;"
          inactive_style = "color:var(--color-text-muted);"
      %>
        <%= link_to label,
              favorites_path(q: params[:q], content_type: value, status: params[:status], sort: params[:sort]),
              data: { turbo_frame: "favorites", turbo_action: "replace" },
              style: "#{is_active ? active_style : inactive_style}padding:4px 12px;border-radius:9999px;font-size:12px;font-weight:600;transition:all 0.15s;white-space:nowrap;" %>
      <% end %>
    </div>
  </div>

  <%# 상태 필터 %>
  <div class="flex items-center gap-2">
    <span style="font-size:10px;font-weight:700;letter-spacing:0.6px;color:var(--color-text-muted);text-transform:uppercase;">상태</span>
    <div class="flex" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:9999px;padding:3px;gap:2px;">
      <%
        status_options = [["전체", nil], ["대기", "pending"], ["분석중", "analyzing"], ["완료", "done"], ["실패", "failed"]]
        status_options.each do |label, value|
          is_active = value.nil? ? params[:status].blank? : params[:status] == value
          active_style = "background:var(--color-accent);color:#fff;"
          inactive_style = "color:var(--color-text-muted);"
      %>
        <%= link_to label,
              favorites_path(q: params[:q], content_type: params[:content_type], status: value, sort: params[:sort]),
              data: { turbo_frame: "favorites", turbo_action: "replace" },
              style: "#{is_active ? active_style : inactive_style}padding:4px 12px;border-radius:9999px;font-size:12px;font-weight:600;transition:all 0.15s;white-space:nowrap;" %>
      <% end %>
    </div>
  </div>

</div>
