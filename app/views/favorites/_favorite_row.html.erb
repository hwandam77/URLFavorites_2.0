<%= link_to favorite_path(favorite), class: "flex items-center justify-between py-3 px-4 bg-white border-b hover:bg-gray-50 block" do %>
  <div class="flex-1 min-w-0">
    <span class="font-medium text-gray-900 truncate"><%= favorite.title %></span>
    <span class="text-sm text-gray-400 ml-2 truncate"><%= favorite.url.truncate(40) %></span>
  </div>
  <div class="flex items-center gap-2 ml-4">
    <% status_class = case favorite.status
      when "pending" then "bg-yellow-100 text-yellow-800"
      when "analyzing" then "bg-blue-100 text-blue-800"
      when "done" then "bg-green-100 text-green-800"
      when "failed" then "bg-red-100 text-red-800"
      else "bg-gray-100 text-gray-800"
    end %>
    <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium <%= status_class %>"><%= favorite.status %></span>
    <span class="text-xs text-gray-400"><%= favorite.content_type %></span>
  </div>
<% end %>
