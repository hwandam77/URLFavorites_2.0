<%
  favicon_url = "https://www.google.com/s2/favicons?domain=#{URI.parse(favorite.url).host rescue favorite.url}&sz=32"

  status_map = {
    "pending"   => { bg: "var(--color-pending-bg)", text: "var(--color-pending-text)", border: "var(--color-pending-border)", label: "대기중" },
    "analyzing" => { bg: "var(--color-analyzing-bg)", text: "var(--color-analyzing-text)", border: "var(--color-analyzing-border)", label: "분석중" },
    "done"      => { bg: "var(--color-done-bg)", text: "var(--color-done-text)", border: "var(--color-done-border)", label: "완료" },
    "failed"    => { bg: "var(--color-failed-bg)", text: "var(--color-failed-text)", border: "var(--color-failed-border)", label: "실패" },
  }
  s = status_map[favorite.status] || { bg: "var(--color-surface)", text: "var(--color-text-tertiary)", border: "var(--color-border)", label: favorite.status }
%>

<tr id="<%= dom_id(favorite) %>"
    style="border-bottom:1px solid var(--color-border-subtle);"
    class="group transition-colors"
    onmouseover="this.style.background='var(--color-surface-hover)'"
    onmouseout="this.style.background='transparent'">
  <%# 파비콘 + 제목 + URL %>
  <td class="py-3 px-4">
    <div class="flex items-center gap-3">
      <img src="<%= favicon_url %>"
           alt=""
           class="w-4 h-4 rounded flex-shrink-0"
           onerror="this.style.display='none'"
           loading="lazy">
      <div class="min-w-0 flex-1">
        <% display_title = favorite.url.to_s.include?("github.com") ? github_repo_name(favorite.url) : (favorite.title.presence || "제목 없음") %>
        <%= link_to favorite_path(favorite), class: "block truncate transition-colors", style: "font-size:var(--text-sm);font-weight:600;color:var(--color-text);", onmouseover: "this.style.color='var(--color-accent)'", onmouseout: "this.style.color='var(--color-text)'" do %>
          <%= display_title %>
        <% end %>
        <p style="font-size:var(--text-xs);color:var(--color-text-tertiary);" class="truncate">
          <%= favorite.url %>
        </p>
      </div>
    </div>
  </td>

  <%# 콘텐츠 유형 %>
  <td class="py-3 px-4 hidden md:table-cell">
    <span style="font-size:var(--text-xs);color:var(--color-text-secondary);">
      <%= favorite.content_type == "youtube" ? "YouTube" : "웹" %>
    </span>
  </td>

  <%# 상태 %>
  <td class="py-3 px-4">
    <span style="background:<%= s[:bg] %>;color:<%= s[:text] %>;border:1px solid <%= s[:border] %>;padding:2px 10px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:600;">
      <%= s[:label] %>
    </span>
  </td>

  <%# 태그 %>
  <td class="py-3 px-4 hidden lg:table-cell">
    <div class="flex gap-1.5 flex-wrap">
      <% if favorite.analysis&.tags.present? %>
        <% favorite.analysis.tags.first(2).each do |tag| %>
          <span style="background:var(--color-accent-muted);color:var(--color-accent-text);padding:2px 8px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:500;">
            <%= tag %>
          </span>
        <% end %>
        <% if favorite.analysis.tags.size > 2 %>
          <span style="font-size:var(--text-xs);color:var(--color-text-tertiary);">+<%= favorite.analysis.tags.size - 2 %></span>
        <% end %>
      <% else %>
        <span style="font-size:var(--text-xs);color:var(--color-text-tertiary);">-</span>
      <% end %>
    </div>
  </td>

  <%# 날짜 %>
  <td class="py-3 px-4 hidden sm:table-cell">
    <span style="font-size:var(--text-xs);color:var(--color-text-tertiary);">
      <%= favorite.created_at.strftime("%m/%d") %>
    </span>
  </td>

  <%# 액션 %>
  <td class="py-3 px-4">
    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
      <button type="button"
              data-action="click->clipboard#copy"
              data-clipboard-url="<%= favorite.url %>"
              class="p-1.5 rounded-md transition-colors"
              style="color:var(--color-text-tertiary);"
              onmouseover="this.style.background='var(--color-surface-hover)'"
              onmouseout="this.style.background='transparent'"
              title="URL 복사">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
        </svg>
      </button>
      <%= link_to favorite_path(favorite, format: :turbo_stream),
            method: :delete,
            data: { action: "confirm:삭제하시겠습니까?" },
            class: "p-1.5 rounded-md transition-colors",
            style: "color:var(--color-text-tertiary);",
            onmouseover: "this.style.background='var(--color-failed-bg)'",
            onmouseout: "this.style.background='transparent'",
            title: "삭제" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
      <% end %>
    </div>
  </td>
</tr>
