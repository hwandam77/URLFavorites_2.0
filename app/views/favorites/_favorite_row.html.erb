<%
  # Favicon URL (Google Favicon API)
  favicon_url = "https://www.google.com/s2/favicons?domain=#{URI.parse(favorite.url).host rescue favorite.url}&sz=32"

  status_style = case favorite.status
    when "pending"   then "background:var(--color-tag-bg);color:var(--color-tag-text);"
    when "analyzing" then "background:var(--color-tag-bg);color:var(--color-tag-text);"
    when "done"      then "background:#dcfce7;color:#166534;"
    when "failed"    then "background:#fef2f2;color:#991b1b;"
    else                  "background:var(--color-surface);color:var(--color-text-muted);"
  end
  status_label = case favorite.status
    when "pending" then "대기중" when "analyzing" then "분석중"
    when "done" then "완료" when "failed" then "실패"
    else favorite.status
  end
%>
<tr style="border-bottom:1px solid var(--color-border);"
    class="hover:bg-black/[0.02] dark:hover:bg-white/[0.02] group">
  <%# Favicon + Title + URL %>
  <td class="py-3 px-4">
    <div class="flex items-center gap-3">
      <img src="<%= favicon_url %>"
           alt=""
           class="w-5 h-5 rounded-sm flex-shrink-0"
           onerror="this.style.display='none'">
      <div class="min-w-0 flex-1">
        <%= link_to favorite_path(favorite), class: "block truncate hover:underline", style: "font-size:14px;font-weight:600;color:var(--color-text);" do %>
          <%= favorite.title.presence || "제목 없음" %>
        <% end %>
        <p style="font-size:12px;color:var(--color-text-muted);" class="truncate">
          <%= favorite.url %>
        </p>
      </div>
    </div>
  </td>

  <%# Content Type %>
  <td class="py-3 px-4 hidden md:table-cell">
    <span style="font-size:12px;color:var(--color-text-muted);">
      <%= favorite.content_type == "youtube" ? "YouTube" : "웹" %>
    </span>
  </td>

  <%# Status %>
  <td class="py-3 px-4">
    <span style="<%= status_style %>padding:2px 8px;border-radius:9999px;font-size:11px;font-weight:600;">
      <%= status_label %>
    </span>
  </td>

  <%# Tags %>
  <td class="py-3 px-4 hidden lg:table-cell">
    <div class="flex gap-1 flex-wrap">
      <% if favorite.analysis&.tags.present? %>
        <% favorite.analysis.tags.first(2).each do |tag| %>
          <span style="background:var(--color-tag-bg);color:var(--color-tag-text);padding:2px 6px;border-radius:9999px;font-size:10px;font-weight:500;">
            <%= tag %>
          </span>
        <% end %>
        <% if favorite.analysis.tags.size > 2 %>
          <span style="font-size:10px;color:var(--color-text-muted);">+<%= favorite.analysis.tags.size - 2 %></span>
        <% end %>
      <% else %>
        <span style="font-size:12px;color:var(--color-text-muted);">-</span>
      <% end %>
    </div>
  </td>

  <%# Date %>
  <td class="py-3 px-4 hidden sm:table-cell">
    <span style="font-size:12px;color:var(--color-text-muted);">
      <%= favorite.created_at.strftime("%m/%d") %>
    </span>
  </td>

  <%# Actions %>
  <td class="py-3 px-4">
    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
      <button type="button"
              data-action="click->clipboard#copy"
              data-clipboard-url="<%= favorite.url %>"
              class="p-1.5 rounded hover:bg-black/5 dark:hover:bg-white/10"
              style="color:var(--color-text-muted);"
              title="URL 복사">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
        </svg>
      </button>
      <%= link_to favorite_path(favorite, format: :turbo_stream),
            method: :delete,
            data: { action: "confirm:삭제하시겠습니까?" },
            class: "p-1.5 rounded hover:bg-red-50 dark:hover:bg-red-900/20",
            style: "color:var(--color-text-muted);",
            title: "삭제" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
      <% end %>
    </div>
  </td>
</tr>
