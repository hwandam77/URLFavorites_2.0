<div class="max-w-2xl mx-auto px-4 py-8">
  <!-- Back link -->
  <div class="mb-4">
    <%= link_to "← Back to Archive", favorites_path, class: "text-blue-600 hover:text-blue-800 inline-block" %>
  </div>

  <!-- Title -->
  <h1 class="text-2xl font-bold text-gray-900 mb-2">
    <%= @favorite.title %>
  </h1>

  <!-- URL -->
  <div class="text-sm break-all mb-4">
    <%= link_to @favorite.url, @favorite.url, target: "_blank", rel: "noopener noreferrer", class: "text-gray-500 hover:text-blue-600" %>
  </div>

  <!-- Status and Content Type badges -->
  <div class="flex flex-wrap gap-2 mb-4">
    <% status_class = case @favorite.status
      when "pending" then "bg-yellow-100 text-yellow-800"
      when "analyzing" then "bg-blue-100 text-blue-800"
      when "done" then "bg-green-100 text-green-800"
      when "failed" then "bg-red-100 text-red-800"
      else "bg-gray-100 text-gray-800"
    end %>
    <span class="inline-flex px-2 py-1 rounded-full text-xs font-medium <%= status_class %>">
      <%= @favorite.status %>
    </span>
    <span class="inline-flex px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
      <%= @favorite.content_type == "youtube" ? "YouTube" : "Webpage" %>
    </span>
  </div>

  <!-- Analysis section -->
  <% if @favorite.analysis.present? %>
    <div class="mt-6 border-t pt-4">
      <h2 class="text-lg font-semibold text-gray-800 mb-3">Analysis</h2>
      <p class="text-gray-700 mb-3"><%= @favorite.analysis.summary %></p>

      <% if @favorite.analysis.tags.present? %>
        <div class="flex flex-wrap gap-1 mb-3">
          <% @favorite.analysis.tags.each do |tag| %>
            <span class="inline-flex bg-gray-100 text-gray-700 px-2 py-0.5 rounded text-sm"><%= tag %></span>
          <% end %>
        </div>
      <% end %>

      <% if @favorite.analysis.key_points.present? %>
        <ul class="list-disc list-inside text-gray-700 space-y-1">
          <% @favorite.analysis.key_points.each do |point| %>
            <li><%= point %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>

  <!-- Note section -->
  <div class="mt-6 border-t pt-4">
    <h2 class="text-lg font-semibold text-gray-800 mb-3">Note</h2>
    <p class="text-gray-700 whitespace-pre-wrap mb-3"><%= @favorite.note.presence || "No note added." %></p>
    <%= render "note_form", favorite: @favorite %>
  </div>

  <!-- Actions -->
  <div class="mt-6 flex gap-3">
    <% if @favorite.status == "failed" %>
      <%= button_to "Retry", retry_favorite_path(@favorite), method: :post,
        class: "bg-yellow-500 text-white px-4 py-2 rounded hover:bg-yellow-600" %>
    <% end %>
    <%= button_to "Delete", favorite_path(@favorite), method: :delete,
      data: { turbo_confirm: "Are you sure?" },
      class: "bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700" %>
  </div>
</div>
