<div class="max-w-4xl mx-auto px-6 py-10" style="--text-xs:14px;--text-sm:17px;">

  <%# 뒤로가기 %>
  <div class="mb-8">
    <%= link_to favorites_path,
          class: "inline-flex items-center gap-1.5 text-sm transition-colors",
          style: "color:var(--color-text-tertiary);font-weight:500;",
          onmouseover: "this.style.color='var(--color-accent)'",
          onmouseout: "this.style.color='var(--color-text-tertiary)'" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      아카이브로 돌아가기
    <% end %>
  </div>

  <%# 패널 헤더 %>
  <div class="flex flex-col gap-3 mb-8 pb-6" style="border-bottom:1px solid var(--color-border);">
    <% display_title = @favorite.title.presence || (@favorite.url.to_s.include?("github.com") ? github_repo_name(@favorite.url) : @favorite.url) %>
    <h1 style="font-size:var(--text-2xl);font-weight:700;letter-spacing:-0.5px;color:var(--color-text);line-height:1.3;">
      <%= display_title %>
    </h1>
    <div class="flex flex-wrap gap-2 items-center">
      <% status_map = {
        "pending"   => { bg: "var(--color-pending-bg)", text: "var(--color-pending-text)", border: "var(--color-pending-border)", label: "대기" },
        "analyzing" => { bg: "var(--color-analyzing-bg)", text: "var(--color-analyzing-text)", border: "var(--color-analyzing-border)", label: "분석중" },
        "done"      => { bg: "var(--color-done-bg)", text: "var(--color-done-text)", border: "var(--color-done-border)", label: "완료" },
        "failed"    => { bg: "var(--color-failed-bg)", text: "var(--color-failed-text)", border: "var(--color-failed-border)", label: "실패" },
      } %>
      <% s = status_map[@favorite.status] || { bg: "var(--color-surface)", text: "var(--color-text-tertiary)", border: "var(--color-border)", label: @favorite.status } %>
      <span style="background:<%= s[:bg] %>;color:<%= s[:text] %>;border:1px solid <%= s[:border] %>;padding:4px 12px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:600;">
        <%= s[:label] %>
      </span>
      <span style="background:var(--color-accent-muted);color:var(--color-accent-text);padding:4px 12px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:600;">
        <%= @favorite.content_type == "youtube" ? "YouTube" : "웹페이지" %>
      </span>
      <a href="<%= @favorite.url %>" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-1.5 transition-all"
         style="
           color:var(--color-accent-text);
           background:var(--color-accent-muted);
           border:1px solid var(--color-accent-muted);
           padding:5px 12px;
           border-radius:var(--radius-md);
           font-size:var(--text-xs);
           font-weight:600;
           text-decoration:none;
         "
         onmouseover="this.style.background='var(--color-accent)';this.style.color='#fff';this.style.borderColor='var(--color-accent)'"
         onmouseout="this.style.background='var(--color-accent-muted)';this.style.color='var(--color-accent-text)';this.style.borderColor='var(--color-accent-muted)'">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
        </svg>
        원본 링크 열기
      </a>
      <span style="flex:1"></span>
      <% if @favorite.status == "failed" %>
        <%= button_to "재시도", retry_favorite_path(@favorite), method: :post,
              class: "transition-all",
              style: "background:var(--color-pending-bg);color:var(--color-pending-text);border:1px solid var(--color-pending-border);padding:6px 14px;border-radius:var(--radius-md);font-size:var(--text-xs);font-weight:600;cursor:pointer;" %>
      <% end %>
      <%= button_to "삭제", favorite_path(@favorite), method: :delete,
            data: { turbo_confirm: "정말 삭제하시겠습니까?" },
            class: "transition-all",
            style: "background:var(--color-failed-bg);color:var(--color-failed-text);border:1px solid var(--color-failed-border);padding:6px 14px;border-radius:var(--radius-md);font-size:var(--text-xs);font-weight:600;cursor:pointer;" %>
    </div>
  </div>

  <%# 분석 결과 %>
  <% if @favorite.analysis.present? %>
    <% has_youtube_thumbnail = @favorite.content_type == "youtube" && @favorite.thumbnail_url.present? %>

    <%# 요약 섹션 %>
    <section class="mb-10">
      <h2 style="font-size:var(--text-sm);font-weight:600;color:var(--color-text-secondary);margin-bottom:16px;display:flex;align-items:center;gap:6px;padding-bottom:8px;margin-bottom:16px;border-bottom:1.5px solid var(--color-accent);">
        <span>📝</span> 요약
      </h2>
      <div class="<%= has_youtube_thumbnail ? 'flex gap-4' : '' %>" style="<%= has_youtube_thumbnail ? 'align-items:flex-start;' : '' %>">
        <% if has_youtube_thumbnail %>
          <img src="<%= @favorite.thumbnail_url %>" class="w-40 h-24 object-cover rounded-md flex-shrink-0" style="border:1px solid var(--color-border);" alt="YouTube thumbnail">
        <% end %>
        <p style="color:var(--color-text-secondary);line-height:1.7;font-size:var(--text-sm);flex:1;"><%= @favorite.analysis.summary %></p>
        <% if @favorite.content_type == "youtube" && @favorite.analysis.subtitle_source.present? %>
          <span style="background:var(--color-accent-muted);color:var(--color-accent-text);padding:2px 8px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:600;flex-shrink:0;">
            자막: <%= @favorite.analysis.subtitle_source %>
          </span>
        <% end %>
      </div>
    </section>

    <%# 태그 섹션 %>
    <% if @favorite.analysis.parsed_tags.any? %>
      <section class="mb-10">
        <h2 style="font-size:var(--text-sm);font-weight:600;color:var(--color-text-secondary);margin-bottom:10px;display:flex;align-items:center;gap:6px;padding-bottom:8px;margin-bottom:16px;border-bottom:1.5px solid var(--color-accent);">
          <span>🏷</span> 태그
        </h2>
        <div class="flex flex-wrap gap-2">
          <% @favorite.analysis.parsed_tags.each do |tag| %>
            <span style="background:var(--color-accent-muted);color:var(--color-accent-text);padding:4px 12px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:500;"><%= tag %></span>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# 핵심 인사이트 섹션 %>
    <% if @favorite.analysis.parsed_key_points.any? %>
      <section class="mb-10">
        <h2 style="font-size:var(--text-sm);font-weight:600;color:var(--color-text-secondary);margin-bottom:10px;display:flex;align-items:center;gap:6px;padding-bottom:8px;margin-bottom:16px;border-bottom:1.5px solid var(--color-accent);">
          <span>💡</span> 핵심 인사이트
        </h2>
        <ul style="list-style:none;padding:0;margin:0;color:var(--color-text-secondary);line-height:1.8;font-size:var(--text-sm);">
          <% @favorite.analysis.parsed_key_points.each do |kp| %>
            <li class="flex items-start gap-2 mb-2" style="<%= kp['category'].present? ? 'padding-left:8px;border-left:2px solid var(--color-accent);' : '' %>">
              <% if kp["category"].present? %>
                <span style="background:var(--color-accent-muted);color:var(--color-accent-text);padding:1px 6px;border-radius:var(--radius-sm);font-size:var(--text-xs);font-weight:600;flex-shrink:0;"><%= kp["category"] %></span>
              <% end %>
              <span class="<%= kp['category'].present? ? '' : 'ml-4' %>"><%= kp["point"] %></span>
              <% if kp["timestamp"].present? %>
                <span style="color:var(--color-text-tertiary);font-size:var(--text-xs);">(<%= kp["timestamp"] %>)</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <%# 상세내용 섹션 %>
    <% if @favorite.analysis.detail_content.present? %>
      <section class="mb-10">
        <h2 style="font-size:var(--text-sm);font-weight:600;color:var(--color-text-secondary);margin-bottom:10px;display:flex;align-items:center;gap:6px;padding-bottom:8px;margin-bottom:16px;border-bottom:1.5px solid var(--color-accent);">
          <span>📄</span> 상세내용
        </h2>
        <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);padding:16px;color:var(--color-text-secondary);line-height:1.8;font-size:var(--text-sm);white-space:pre-wrap;"><%= @favorite.analysis.detail_content %></div>
      </section>
    <% end %>

    <%# 메타 섹션 %>
    <section class="mb-10">
      <div class="flex flex-wrap gap-4 text-xs" style="color:var(--color-text-tertiary);">
        <% if @favorite.analysis.sentiment.present? %>
          <span>🎭 감정: <%= @favorite.analysis.sentiment %></span>
        <% end %>
        <span>📅 저장: <%= @favorite.created_at.strftime("%Y-%m-%d") %></span>
        <% if @favorite.analysis.model_used.present? %>
          <span>🤖 <%= @favorite.analysis.model_used %></span>
        <% end %>
      </div>
    </section>

  <% elsif @favorite.status == "analyzing" %>
    <div class="flex items-center gap-3 mb-8" style="color:var(--color-analyzing-text);">
      <div class="w-4 h-4 rounded-full animate-spin" style="border:2px solid var(--color-analyzing-border);border-top-color:var(--color-analyzing-text);"></div>
      AI 분석 중입니다...
    </div>
  <% end %>

  <%# 메모 섹션 %>
  <section class="mb-10">
    <h2 style="font-size:var(--text-sm);font-weight:600;color:var(--color-text-secondary);margin-bottom:10px;display:flex;align-items:center;gap:6px;padding-bottom:8px;margin-bottom:16px;border-bottom:1.5px solid var(--color-accent);">
      <span>📝</span> 메모
    </h2>
    <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);padding:16px;margin-bottom:12px;">
      <% if @favorite.note.present? %>
        <p style="color:var(--color-text-secondary);white-space:pre-wrap;line-height:1.7;font-size:var(--text-sm);margin-bottom:0;"><%= @favorite.note %></p>
      <% else %>
        <p style="color:var(--color-text-tertiary);font-size:var(--text-sm);margin-bottom:0;">아직 메모가 없습니다</p>
      <% end %>
    </div>
    <%= render "note_form", favorite: @favorite %>
  </section>

  <%# 같은 분류 북마크 %>
  <% related = @favorite.respond_to?(:collection_id) && @favorite.collection_id.present? \
       ? Favorite.where(collection_id: @favorite.collection_id).where.not(id: @favorite.id).where(status: "done").order(created_at: :desc).limit(10) \
       : Favorite.none %>
  <% if related.any? %>
    <section class="mb-8">
      <h2 style="font-size:var(--text-sm);font-weight:600;color:var(--color-text-secondary);margin-bottom:10px;display:flex;align-items:center;gap:6px;">
        <span>📂</span> 같은 컬렉션
      </h2>
      <div class="flex flex-col gap-2">
        <% related.each do |rel| %>
          <%= link_to favorite_path(rel), class: "flex items-center gap-3 p-3 transition-all", style: "background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);", onmouseover: "this.style.borderColor='var(--color-accent-muted)'", onmouseout: "this.style.borderColor='var(--color-border)'" do %>
            <span style="background:var(--color-accent-muted);color:var(--color-accent-text);padding:2px 8px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:600;flex-shrink:0;">
              <%= rel.content_type == "youtube" ? "YouTube" : "웹페이지" %>
            </span>
            <span style="color:var(--color-text-secondary);font-size:var(--text-sm);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= rel.title&.truncate(60) || rel.url %></span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
