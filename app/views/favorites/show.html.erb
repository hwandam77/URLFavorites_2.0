<div class="max-w-2xl mx-auto px-6 py-10">

  <%# 뒤로가기 %>
  <div class="mb-8">
    <%= link_to favorites_path,
          class: "inline-flex items-center gap-1.5 text-sm transition-colors",
          style: "color:var(--color-text-tertiary);font-weight:500;",
          onmouseover: "this.style.color='var(--color-accent)'",
          onmouseout: "this.style.color='var(--color-text-tertiary)'" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      아카이브로 돌아가기
    <% end %>
  </div>

  <%# 제목 %>
  <h1 style="font-size:var(--text-2xl);font-weight:700;letter-spacing:-0.5px;color:var(--color-text);margin-bottom:8px;line-height:1.3;">
    <%= @favorite.title.presence || "제목 없음" %>
  </h1>

  <%# URL %>
  <div style="font-size:var(--text-sm);word-break:break-all;margin-bottom:20px;">
    <%= link_to @favorite.url, @favorite.url, target: "_blank", rel: "noopener noreferrer",
          class: "transition-colors",
          style: "color:var(--color-text-tertiary);",
          onmouseover: "this.style.color='var(--color-accent)'",
          onmouseout: "this.style.color='var(--color-text-tertiary)'" %>
  </div>

  <%# 상태 + 유형 배지 %>
  <%
    status_map = {
      "pending"   => { bg: "var(--color-pending-bg)", text: "var(--color-pending-text)", border: "var(--color-pending-border)", label: "대기" },
      "analyzing" => { bg: "var(--color-analyzing-bg)", text: "var(--color-analyzing-text)", border: "var(--color-analyzing-border)", label: "분석중" },
      "done"      => { bg: "var(--color-done-bg)", text: "var(--color-done-text)", border: "var(--color-done-border)", label: "완료" },
      "failed"    => { bg: "var(--color-failed-bg)", text: "var(--color-failed-text)", border: "var(--color-failed-border)", label: "실패" },
    }
    s = status_map[@favorite.status] || { bg: "var(--color-surface)", text: "var(--color-text-tertiary)", border: "var(--color-border)", label: @favorite.status }
  %>
  <div class="flex flex-wrap gap-2 mb-8">
    <span style="background:<%= s[:bg] %>;color:<%= s[:text] %>;border:1px solid <%= s[:border] %>;padding:4px 12px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:600;">
      <%= s[:label] %>
    </span>
    <span style="background:var(--color-accent-muted);color:var(--color-accent-text);padding:4px 12px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:600;">
      <%= @favorite.content_type == "youtube" ? "YouTube" : "웹페이지" %>
    </span>
  </div>

  <%# 분석 결과 %>
  <% if @favorite.analysis.present? %>
    <div class="rounded-lg p-5 mb-8" style="background:var(--color-surface);border:1px solid var(--color-border);">
      <h2 style="font-size:var(--text-lg);font-weight:600;color:var(--color-text);margin-bottom:12px;">분석 결과</h2>
      <p style="color:var(--color-text-secondary);margin-bottom:16px;line-height:1.7;font-size:var(--text-sm);">
        <%= @favorite.analysis.summary %>
      </p>

      <% if @favorite.analysis.tags.present? %>
        <div class="flex flex-wrap gap-1.5 mb-4">
          <% @favorite.analysis.tags.each do |tag| %>
            <span style="background:var(--color-accent-muted);color:var(--color-accent-text);padding:3px 10px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:500;"><%= tag %></span>
          <% end %>
        </div>
      <% end %>

      <% if @favorite.analysis.key_points.present? %>
        <ul style="list-style:none;padding:0;margin:0;color:var(--color-text-secondary);line-height:1.8;font-size:var(--text-sm);">
          <% @favorite.analysis.key_points.each do |point| %>
            <li class="flex items-start gap-2 mb-1.5">
              <span class="mt-1.5 w-1.5 h-1.5 rounded-full flex-shrink-0" style="background:var(--color-accent);"></span>
              <%= point %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>

  <%# 메모 %>
  <div class="rounded-lg p-5 mb-8" style="background:var(--color-surface);border:1px solid var(--color-border);">
    <h2 style="font-size:var(--text-lg);font-weight:600;color:var(--color-text);margin-bottom:12px;">메모</h2>
    <% if @favorite.note.present? %>
      <p style="color:var(--color-text-secondary);white-space:pre-wrap;margin-bottom:16px;line-height:1.7;font-size:var(--text-sm);"><%= @favorite.note %></p>
    <% else %>
      <p style="color:var(--color-text-tertiary);margin-bottom:16px;font-size:var(--text-sm);">아직 메모가 없습니다</p>
    <% end %>
    <%= render "note_form", favorite: @favorite %>
  </div>

  <%# 액션 %>
  <div class="flex gap-3">
    <% if @favorite.status == "failed" %>
      <%= button_to "재시도", retry_favorite_path(@favorite), method: :post,
        class: "transition-all",
        style: "background:var(--color-pending-bg);color:var(--color-pending-text);border:1px solid var(--color-pending-border);padding:8px 20px;border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:600;cursor:pointer;" %>
    <% end %>
    <%= button_to "삭제", favorite_path(@favorite), method: :delete,
      data: { turbo_confirm: "정말 삭제하시겠습니까?" },
      class: "transition-all",
      style: "background:var(--color-failed-bg);color:var(--color-failed-text);border:1px solid var(--color-failed-border);padding:8px 20px;border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:600;cursor:pointer;" %>
  </div>
</div>
