<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "URL 즐겨찾기" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="URL 즐겨찾기">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Google Fonts — Inter (Notion 디자인 시스템 기반) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <style>
      /* ================================================
         URLFavorites 2.0 — Design System
         Archetype: Warm Archive (Editorial Swiss)
         Differentiator: Warm amber accent on layered surfaces
                         with typographic hierarchy
      ================================================ */

      :root {
        /* ── Spacing Scale ── */
        --space-1: 4px;
        --space-2: 8px;
        --space-3: 12px;
        --space-4: 16px;
        --space-5: 20px;
        --space-6: 24px;
        --space-8: 32px;
        --space-10: 40px;
        --space-12: 48px;
        --space-16: 64px;

        /* ── Border Radius ── */
        --radius-sm: 4px;
        --radius-md: 8px;
        --radius-lg: 12px;
        --radius-xl: 16px;
        --radius-full: 9999px;

        /* ── Typography ── */
        --text-xs: 11px;
        --text-sm: 13px;
        --text-base: 15px;
        --text-lg: 17px;
        --text-xl: 20px;
        --text-2xl: 28px;
        --text-3xl: 36px;

        /* ── Color Tokens — Dark Mode (Default) ── */
        --color-bg: #0c0c0c;
        --color-surface: #151515;
        --color-surface-raised: #1c1c1c;
        --color-surface-hover: #222222;
        --color-border: #272727;
        --color-border-subtle: #1e1e1e;
        --color-accent: #e07a2f;
        --color-accent-hover: #c96a22;
        --color-accent-muted: rgba(224, 122, 47, 0.10);
        --color-accent-text: #f4a261;
        --color-text: #e4e4e4;
        --color-text-secondary: #a0a0a0;
        --color-text-tertiary: #666666;
        --color-text-placeholder: #444444;

        /* Status */
        --color-pending-bg: rgba(255, 190, 0, 0.08);
        --color-pending-text: #e6ac00;
        --color-pending-border: rgba(255, 190, 0, 0.2);
        --color-analyzing-bg: rgba(96, 165, 250, 0.08);
        --color-analyzing-text: #60a5fa;
        --color-analyzing-border: rgba(96, 165, 250, 0.2);
        --color-done-bg: rgba(52, 211, 153, 0.08);
        --color-done-text: #34d399;
        --color-done-border: rgba(52, 211, 153, 0.2);
        --color-failed-bg: rgba(248, 113, 113, 0.08);
        --color-failed-text: #f87171;
        --color-failed-border: rgba(248, 113, 113, 0.2);

        /* Interactive */
        --color-focus-ring: var(--color-accent);
        --color-overlay: rgba(0, 0, 0, 0.6);

        /* Shadows */
        --shadow-sm: 0 1px 2px rgba(0,0,0,0.15);
        --shadow-md: 0 2px 8px rgba(0,0,0,0.2);
        --shadow-lg: 0 4px 16px rgba(0,0,0,0.25);
      }

      body {
        font-family: 'Inter', -apple-system, system-ui, sans-serif;
        font-size: var(--text-base);
        background-color: var(--color-bg);
        color: var(--color-text);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* ── Color Tokens — Light Mode ── */
      .light {
        --color-bg: #f7f6f3;
        --color-surface: #ffffff;
        --color-surface-raised: #ffffff;
        --color-surface-hover: #f0efec;
        --color-border: #e0ddd7;
        --color-border-subtle: #ebe9e4;
        --color-accent: #c4600a;
        --color-accent-hover: #a85208;
        --color-accent-muted: rgba(196, 96, 10, 0.06);
        --color-accent-text: #c4600a;
        --color-text: #1a1917;
        --color-text-secondary: #6b6960;
        --color-text-tertiary: #9e9b8f;
        --color-text-placeholder: #bfbdb4;

        /* Status */
        --color-pending-bg: rgba(180, 130, 0, 0.08);
        --color-pending-text: #996b00;
        --color-pending-border: rgba(180, 130, 0, 0.2);
        --color-analyzing-bg: rgba(37, 99, 235, 0.06);
        --color-analyzing-text: #2563eb;
        --color-analyzing-border: rgba(37, 99, 235, 0.15);
        --color-done-bg: rgba(22, 163, 74, 0.06);
        --color-done-text: #16a34a;
        --color-done-border: rgba(22, 163, 74, 0.15);
        --color-failed-bg: rgba(220, 38, 38, 0.06);
        --color-failed-text: #dc2626;
        --color-failed-border: rgba(220, 38, 38, 0.15);

        /* Interactive */
        --color-focus-ring: var(--color-accent);
        --color-overlay: rgba(0, 0, 0, 0.3);

        /* Shadows */
        --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
        --shadow-md: 0 2px 8px rgba(0,0,0,0.06);
        --shadow-lg: 0 4px 16px rgba(0,0,0,0.08);

        color-scheme: light;
      }

      /* ── App Shell ── */
      .app-shell {
        display: flex;
        height: 100dvh;
        overflow: hidden;
      }
      .main-content {
        flex: 1;
        overflow-y: auto;
        background-color: var(--color-bg);
      }

      /* ── Mobile: Sidebar Drawer ── */
      @media (max-width: 768px) {
        .sidebar {
          position: fixed;
          top: 0; left: 0; bottom: 0;
          z-index: 50;
          transform: translateX(-100%);
          transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        body.sidebar-open .sidebar {
          transform: translateX(0);
        }
      }

      /* ── Focus Ring ── */
      :focus-visible {
        outline: 2px solid var(--color-focus-ring);
        outline-offset: 2px;
      }

      /* ── Animations ── */
      @keyframes animate-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
      }

      /* ── Utility: Truncate ── */
      .truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
    </style>

    <%# 다크 모드 초기화 (FOUC 방지) - 다크 모드 기본 %>
    <script>
      (function() {
        // Default to dark mode, allow toggle to light
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body>
    <div class="app-shell" data-controller="sidebar">
      <%# 모바일 오버레이 %>
      <div class="fixed inset-0 bg-black/40 z-40 hidden md:hidden"
           data-sidebar-target="overlay"
           data-action="click->sidebar#closeOnOverlayClick"></div>

      <%# 사이드바 (데스크탑: 항상 표시, 모바일: 드로어) %>
      <div class="hidden md:flex">
        <%= render "shared/sidebar" %>
      </div>
      <div class="flex md:hidden">
        <%= render "shared/sidebar" %>
      </div>

      <%# 메인 컨텐츠 %>
      <main class="main-content">
        <%# 모바일 헤더 %>
        <div class="flex items-center gap-3 px-4 py-3 border-b md:hidden sticky top-0 z-10"
             style="border-color:var(--color-border);background:var(--color-bg);">
          <button type="button"
                  data-action="click->sidebar#toggle"
                  class="p-2 rounded-md transition-colors"
                  style="color:var(--color-text-secondary);"
                  onmouseover="this.style.background='var(--color-surface-hover)'"
                  onmouseout="this.style.background='transparent'">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
          <span style="font-size:var(--text-base);font-weight:700;color:var(--color-text);letter-spacing:-0.3px;">URLFavorites</span>
        </div>

        <%# Flash 메시지 %>
        <% if notice || alert %>
          <div class="mx-4 mt-3 px-4 py-3 rounded-lg text-sm font-medium"
               style="
                 <% if alert %>
                   background:var(--color-failed-bg);
                   color:var(--color-failed-text);
                   border:1px solid var(--color-failed-border);
                 <% else %>
                   background:var(--color-done-bg);
                   color:var(--color-done-text);
                   border:1px solid var(--color-done-border);
                 <% end %>
               ">
            <%= alert || notice %>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
