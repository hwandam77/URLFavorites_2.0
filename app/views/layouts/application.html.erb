<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "URL 즐겨찾기" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="URL 즐겨찾기">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Google Fonts — Inter (Notion 디자인 시스템 기반) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <style>
      /* Editorial Design Tokens — Light Mode */
      :root {
        --color-bg: #faf7f2;
        --color-surface: #fffbf5;
        --color-border: #e8ddd0;
        --color-accent: #c2410c;
        --color-text: #1c1917;
        --color-text-muted: #78716c;
        --color-tag-bg: #fef3c7;
        --color-tag-text: #92400e;
      }
      body {
        font-family: 'Inter', -apple-system, system-ui, 'Segoe UI', Helvetica, Arial, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text);
      }
      /* Editorial Design Tokens — Dark Mode */
      .dark {
        --color-bg: #1c1917;
        --color-surface: #292524;
        --color-border: #44403c;
        --color-accent: #f59e0b;
        --color-text: #faf7f2;
        --color-text-muted: #a8a29e;
        --color-tag-bg: #451a03;
        --color-tag-text: #fed7aa;
        color-scheme: dark;
      }
      /* 앱 셸 레이아웃 */
      .app-shell {
        display: flex;
        height: 100dvh;
        overflow: hidden;
      }
      .sidebar {
        flex-shrink: 0;
        background-color: var(--color-surface);
        border-color: var(--color-border);
      }
      .main-content {
        flex: 1;
        overflow-y: auto;
        background-color: var(--color-bg);
      }
      /* 모바일: 사이드바 드로어 */
      @media (max-width: 768px) {
        .sidebar {
          position: fixed;
          top: 0; left: 0; bottom: 0;
          z-index: 50;
          transform: translateX(-100%);
          transition: transform 0.2s ease;
        }
        body.sidebar-open .sidebar {
          transform: translateX(0);
        }
      @keyframes animate-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
    </style>

    <%# 다크 모드 초기화 (FOUC 방지) %>
    <script>
      (function() {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body>
    <div class="app-shell" data-controller="sidebar">
      <%# 모바일 오버레이 %>
      <div class="fixed inset-0 bg-black/40 z-40 hidden md:hidden"
           data-sidebar-target="overlay"
           data-action="click->sidebar#closeOnOverlayClick"></div>

      <%# 사이드바 (데스크탑: 항상 표시, 모바일: 드로어) %>
      <div class="hidden md:flex">
        <%= render "shared/sidebar" %>
      </div>
      <div class="flex md:hidden">
        <%= render "shared/sidebar" %>
      </div>

      <%# 메인 컨텐츠 %>
      <main class="main-content">
        <%# 모바일 헤더 %>
        <div class="flex items-center gap-3 px-4 py-3 border-b border-black/10 dark:border-white/10 md:hidden sticky top-0 bg-stone-50 dark:bg-stone-900 z-10">
          <button type="button"
                  data-action="click->sidebar#toggle"
                  class="p-1.5 rounded-md text-stone-600 dark:text-stone-400 hover:bg-stone-200 dark:hover:bg-stone-700">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
          <span style="font-size:15px;font-weight:700;" class="text-stone-900 dark:text-stone-100">URLFavorites</span>
        </div>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
