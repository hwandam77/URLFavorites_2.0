<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "URL 즐겨찾기" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="URL 즐겨찾기">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Google Fonts — Warm Tactile Command Grid %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <style>
      /* ── App Shell ── */
      .app-shell {
        display: flex;
        height: 100dvh;
        overflow: hidden;
      }
      .main-content {
        flex: 1;
        overflow-y: auto;
        background:
          linear-gradient(rgba(36, 31, 24, 0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(36, 31, 24, 0.032) 1px, transparent 1px),
          radial-gradient(circle at 20% 10%, rgba(183, 101, 70, 0.14), transparent 30rem),
          linear-gradient(120deg, rgba(255, 253, 248, 0.72), rgba(239, 232, 220, 0.88)),
          var(--color-bg);
        background-size: 18px 18px, 18px 18px, auto, auto;
      }

      .dark .main-content {
        background:
          linear-gradient(rgba(242, 234, 220, 0.028) 1px, transparent 1px),
          linear-gradient(90deg, rgba(242, 234, 220, 0.02) 1px, transparent 1px),
          radial-gradient(circle at 20% 10%, rgba(255, 95, 31, 0.10), transparent 30rem),
          var(--color-bg);
        background-size: 18px 18px, 18px 18px, auto, auto;
      }

      /* ── Mobile: Sidebar Drawer ── */
      @media (max-width: 768px) {
        .sidebar {
          position: fixed;
          top: 0; left: 0; bottom: 0;
          z-index: 50;
          transform: translateX(-100%);
          transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        body.sidebar-open .sidebar {
          transform: translateX(0);
        }
      }

      /* ── Focus Ring ── */
      :focus-visible {
        outline: 2px solid var(--color-focus-ring);
        outline-offset: 2px;
      }

      .urlf-workspace-header,
      .urlf-workspace-body {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-5);
      }

      .urlf-command-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-3);
      }

      .urlf-desktop-rail {
        display: none;
      }

      .urlf-card-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-3);
      }

      @media (min-width: 768px) {
        .urlf-card-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (min-width: 1024px) {
        .urlf-command-grid {
          grid-template-columns: minmax(320px, 1fr) minmax(280px, 0.8fr) auto;
        }
      }

      @media (min-width: 1280px) {
        .urlf-workspace-header,
        .urlf-workspace-body {
          grid-template-columns: minmax(0, 1fr) 320px;
        }

        .urlf-desktop-rail {
          display: block;
        }
      }

      @media (min-width: 1536px) {
        .urlf-card-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
    </style>

    <%# 3-way 테마 초기화 (FOUC 방지) - 라이트 모드 기본 %>
    <script>
      (function() {
        var theme = localStorage.getItem('theme');
        document.documentElement.classList.remove('dark', 'sepia');
        if (theme === 'dark' || theme === 'sepia') {
          document.documentElement.classList.add(theme);
        }
        // 기본은 라이트 (클스 없음)
      })();
    </script>

    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-shell" data-controller="sidebar">
      <%# 모바일 오버레이 %>
      <div class="fixed inset-0 bg-black/40 z-40 hidden md:hidden"
           data-sidebar-target="overlay"
           data-action="click->sidebar#closeOnOverlayClick"></div>

      <%# 사이드바 (데스크탑: 항상 표시, 모바일: 드로어) %>
      <div class="hidden md:flex">
        <%= render "shared/sidebar" %>
      </div>
      <div class="flex md:hidden">
        <%= render "shared/sidebar" %>
      </div>

      <%# 메인 컨텐츠 %>
      <main class="main-content">
        <%# 모바일 헤더 %>
        <div class="flex items-center gap-3 px-4 py-3 border-b md:hidden sticky top-0 z-10"
             style="border-color:var(--color-border);background:var(--color-bg);">
          <button type="button"
                  data-action="click->sidebar#toggle"
                  class="p-2 rounded-md transition-colors"
                  style="color:var(--color-text-secondary);"
                  onmouseover="this.style.background='var(--color-surface-hover)'"
                  onmouseout="this.style.background='transparent'">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
          <span style="font-size:var(--text-base);font-weight:700;color:var(--color-text);letter-spacing:-0.3px;">URLFavorites</span>
        </div>

        <%# Flash 메시지 %>
        <% if notice || alert %>
          <div class="mx-4 mt-3 px-4 py-3 rounded-lg text-sm font-medium"
               style="
                 <% if alert %>
                   background:var(--color-failed-bg);
                   color:var(--color-failed-text);
                   border:1px solid var(--color-failed-border);
                 <% else %>
                   background:var(--color-done-bg);
                   color:var(--color-done-text);
                   border:1px solid var(--color-done-border);
                 <% end %>
               ">
            <%= alert || notice %>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
