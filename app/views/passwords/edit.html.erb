<% content_for :title, "비밀번호 변경" %>

<div class="min-h-full flex items-center justify-center px-4 py-10">
  <section class="w-full max-w-sm rounded-lg p-5"
           style="background:var(--color-command-bg);border:1px solid var(--color-border);box-shadow:var(--shadow-md);backdrop-filter:blur(18px);">
    <div class="mb-5">
      <div class="mb-2 flex items-center gap-2">
        <span style="height:8px;width:8px;border-radius:var(--radius-full);background:var(--color-accent);display:inline-block;"></span>
        <span style="font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);font-weight:700;color:var(--color-accent-text);text-transform:uppercase;">URLFAV Account</span>
      </div>
      <h1 style="font-size:var(--text-2xl);font-weight:700;letter-spacing:0;color:var(--color-text);line-height:1.15;">비밀번호 변경</h1>
      <p style="margin-top:var(--space-2);font-size:var(--text-sm);color:var(--color-text-secondary);">
        <%= Current.user&.email_address %> 계정의 비밀번호를 변경합니다.<br>
        변경 시 다른 기기의 로그인은 해제됩니다.
      </p>
    </div>

    <%= form_with url: password_path, scope: :password, method: :patch, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :current_password, "현재 비밀번호",
          style: "display:block;margin-bottom:var(--space-2);font-size:var(--text-sm);font-weight:700;color:var(--color-text-secondary);" %>
        <%= form.password_field :current_password,
          required: true,
          autocomplete: "current-password",
          style: "
            width:100%;
            background:var(--color-surface);
            border:1px solid var(--color-border);
            border-radius:var(--radius-md);
            padding:11px 12px;
            font-size:var(--text-sm);
            font-weight:500;
            color:var(--color-text);
            outline:none;
          " %>
      </div>

      <div>
        <%= form.label :password, "새 비밀번호 (최소 6자)",
          style: "display:block;margin-bottom:var(--space-2);font-size:var(--text-sm);font-weight:700;color:var(--color-text-secondary);" %>
        <%= form.password_field :password,
          required: true,
          minlength: 6,
          autocomplete: "new-password",
          style: "
            width:100%;
            background:var(--color-surface);
            border:1px solid var(--color-border);
            border-radius:var(--radius-md);
            padding:11px 12px;
            font-size:var(--text-sm);
            font-weight:500;
            color:var(--color-text);
            outline:none;
          " %>
      </div>

      <div>
        <%= form.label :password_confirmation, "새 비밀번호 확인",
          style: "display:block;margin-bottom:var(--space-2);font-size:var(--text-sm);font-weight:700;color:var(--color-text-secondary);" %>
        <%= form.password_field :password_confirmation,
          required: true,
          autocomplete: "new-password",
          style: "
            width:100%;
            background:var(--color-surface);
            border:1px solid var(--color-border);
            border-radius:var(--radius-md);
            padding:11px 12px;
            font-size:var(--text-sm);
            font-weight:500;
            color:var(--color-text);
            outline:none;
          " %>
      </div>

      <%= form.submit "비밀번호 변경",
        style: "
          width:100%;
          background:var(--color-accent);
          color:#fff;
          border:none;
          border-radius:var(--radius-md);
          padding:11px 14px;
          font-size:var(--text-sm);
          font-weight:800;
          cursor:pointer;
        ",
        onmouseover: "this.style.background='var(--color-accent-hover)'",
        onmouseout: "this.style.background='var(--color-accent)'" %>
    <% end %>

    <div class="mt-4" style="border-top:1px solid var(--color-border);padding-top:var(--space-4);">
      <%= link_to "즐겨찾기로 돌아가기", favorites_path,
        style: "font-size:var(--text-sm);font-weight:600;color:var(--color-text-secondary);text-decoration:none;" %>
    </div>
  </section>
</div>
