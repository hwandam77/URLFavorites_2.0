{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hwandam/workspace/scripts/orchestration/hooks/supervisor-alert.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "set -a; [ -f \"$CLAUDE_PROJECT_DIR/.claude/orchestration.env\" ] && . \"$CLAUDE_PROJECT_DIR/.claude/orchestration.env\"; set +a; /Users/hwandam/workspace/scripts/orchestration/hooks/worker-stop-notify.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
