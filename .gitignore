# Ignore bundler config.
/.bundle

# Ignore all environment files.
.env
.env.*
*.env

# Backup files
*.bak

# Ignore all logfiles and tempfiles.
/log/*
errors.log
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files and SQLite databases in development).
/storage/*.sqlite3
/storage/*.sqlite3-*
/storage/*.sqlite3*
/db/*.sqlite3
/db/*.sqlite3-*
/db/*.sqlite3*
/public/assets/

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials/*.key

# Ignore node_modules
/node_modules

# Ignore assets output
/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore vendor gems
/vendor/bundle

# Machine-local artifacts (not committed)
.omx/
.claude/orchestration.installed
