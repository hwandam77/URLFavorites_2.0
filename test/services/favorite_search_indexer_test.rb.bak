# test/services/favorite_search_indexer_test.rb
require 'test_helper'

class FavoriteSearchIndexerTest < ActiveSupport::TestCase
  test "indexes a favorite with analysis into FTS table" do
    fav = Favorite.create!(
      title: "Rails Guide",
      url: "https://guides.rubyonrails.org",
      content_type: "webpage",
      status: "done"
    )
    Analysis.create!(
      favorite: fav,
      summary: "MVC framework guide",
      tags: ["rails"],
      key_points: []
    )
    FavoriteSearchIndexer.index(fav)

    row = ActiveRecord::Base.connection.execute(
      "SELECT * FROM favorites_fts WHERE favorite_id = #{fav.id}"
    ).first

    assert_not_nil row
    assert_equal "Rails Guide", row["title"]
    assert_includes row["summary"], "MVC"
  end

  test "indexes a favorite without analysis (nil summary/tags)" do
    fav = Favorite.create!(
      title: "Pending URL",
      url: "https://example.com",
      content_type: "webpage",
      status: "pending"
    )
    FavoriteSearchIndexer.index(fav)

    row = ActiveRecord::Base.connection.execute(
      "SELECT * FROM favorites_fts WHERE favorite_id = #{fav.id}"
    ).first

    assert_not_nil row
    assert_equal "Pending URL", row["title"]
  end

  test "updates existing FTS row when re-indexed" do
    fav = Favorite.create!(
      title: "Old Title",
      url: "https://example.com/old",
      content_type: "webpage",
      status: "done"
    )
    FavoriteSearchIndexer.index(fav)

    fav.update!(title: "New Title")
    FavoriteSearchIndexer.index(fav)

    rows = ActiveRecord::Base.connection.execute(
      "SELECT * FROM favorites_fts WHERE favorite_id = #{fav.id}"
    ).to_a

    assert_equal 1, rows.count
    assert_equal "New Title", rows.first["title"]
  end

  test "removes FTS row when favorite deleted" do
    fav = Favorite.create!(
      title: "To Delete",
      url: "https://example.com/del",
      content_type: "webpage",
      status: "done"
    )
    FavoriteSearchIndexer.index(fav)
    FavoriteSearchIndexer.remove(fav.id)

    row = ActiveRecord::Base.connection.execute(
      "SELECT * FROM favorites_fts WHERE favorite_id = #{fav.id}"
    ).first

    assert_nil row
  end

  test "reindex_all indexes all favorites" do
    Favorite.create!(title: "A", url: "https://a.com", content_type: "webpage", status: "done")
    Favorite.create!(title: "B", url: "https://b.com", content_type: "webpage", status: "done")
    FavoriteSearchIndexer.reindex_all

    count = ActiveRecord::Base.connection.execute(
      "SELECT COUNT(*) as c FROM favorites_fts"
    ).first["c"]

    assert count >= 2
  end
end
